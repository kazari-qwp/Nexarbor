          {
            "type": "subnode",
            "node_id": "context/child",
            "name": "新成员 · 上下文",
            "description": "",
            "management_parent_id": null,
            "divergence": 0,
            "data_kind": null,
            "parameters": {
              "parent_id": "child",
              "use_parent_links": false,
              "share_links": false
            },
            "connections": {
              "interfaces": [
                {
                  "target_node_id": "world/time",
