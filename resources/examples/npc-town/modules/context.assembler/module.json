                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "default": [
                  "context.assembler"
                ]
              },
              "system_prompt_channels": {
                "type": "array",
                "title": "系统指令频道",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "default": [
                  "context.assembler.system_prompt"
                ]
              },
              "context_channels": {
                "type": "array",
                "title": "长效资料频道",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "default": [
                  "context.assembler.context"
                ]
              },
              "inputs_channels": {
                "type": "array",
                "title": "一次性输入频道",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "default": [
                  "context.assembler.inputs"
                ]
              },
              "tail_channels": {
                "type": "array",
                "title": "尾部快照频道",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "default": [
                  "context.assembler.tail"
                ]
              },
              "channel_modes": {
                "type": "object",
                "title": "频道匹配模式",
                "additionalProperties": {
                  "enum": [
                    "allow",
                    "deny"
                  ]
                }
              }
            },
            "required": []
          }
        },
        "required": []
      },
      "result": {
        "type": "object"
      }
    },
    {
      "name": "collect",
      "channels": {
        "config": "channels"
      },
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "type": "object"
      }
    }
  ],
  "signals": [],
  "agent_tools": [],
  "frontend": {
    "entry": "ui.html",
    "title": "上下文来源与装配预览",
    "height": 700,
    "preview_operation": "preview"
  }
}
