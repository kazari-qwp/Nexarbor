  {
    "id": "kb_intake",
    "name": "kb_intake",
    "description": "查看入库资料；省略id列出待办。已存原件可associate关联记录；非资料可dismiss说明原因。",
    "operation": "kb_intake",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "action": {
          "type": "string",
          "enum": [
            "read",
            "associate",
            "dismiss"
          ],
          "description": "默认read；已保存的同一原件可associate关联record_id，非资料的任务指令可dismiss并填写reason。"
        },
        "record_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
