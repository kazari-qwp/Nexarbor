{
  "format": "nexarbor-module/v4",
  "id": "cooperation.group",
  "name": "去中心化协作组",
  "description": "旧提出候选、全员验收、否决返工和自动交付协议。",
  "entry": "module.py:CooperativeGroupModule",
  "node_types": [
    "node"
  ],
  "requires": [],
  "config_schema": {
    "type": "object",
    "properties": {
      "output": {
        "type": "string",
        "format": "node-id"
      },
      "findings": {
        "type": "string",
        "format": "node-id"
      },
      "directory": {
        "type": "string"
      },
      "member_channel": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  },
  "state_schema": {
    "type": "object",
    "additionalProperties": true
  },
  "operations": [
    {
      "name": "status",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "section": {
            "type": "string",
            "enum": [
              "all",
              "summary",
              "claims",
              "records",
              "candidate"
            ],
            "default": "all",
            "description": "选择要读取的内容。"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "claim",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "claim",
              "extend",
              "complete",
              "release"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "description": "预计添加、修改或删除的工作区相对文件或目录路径；调查任务可省略。extend 时补充原认领的路径。",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "note",
      "parameters": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "OBSERVED",
              "FACT",
              "FAIL",
              "PATCH_SUMMARY"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "content"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "workspace",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "inspect",
              "sync",
              "publish"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "finish",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "propose",
              "approve",
              "reject"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "test_scripts": {
            "type": "array",
            "description": "已提交的测试脚本在共同工作区中的相对路径。",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "test_results": {
            "type": "array",
            "description": "自己的测试结果文件路径。",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "log_ids": {
            "type": "array",
            "description": "附上的终端日志ID；省略时附上自己本次运行的日志。",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "action",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "start",
      "parameters": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "minLength": 1
          },
          "budget_minutes": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 1440
          }
        },
        "required": [
          "task"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "stop",
      "parameters": {
        "type": "object",
        "properties": {
          "failure": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "command_logs",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list",
              "read"
            ]
          },
          "log_id": {
            "type": "string"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "request",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "result": {}
    }
  ],
