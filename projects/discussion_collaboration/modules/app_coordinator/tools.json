[
  {
    "id": "start",
    "name": "启动任务",
    "description": "启动一次编排任务：让讨论会话开始讨论，并记录为当前运行。",
    "operation": "start",
    "parameters": {
      "type": "object",
      "title": "启动参数",
      "properties": {
        "task": {
          "type": "string",
          "title": "任务",
          "description": "本次要讨论和执行的完整任务描述。",
          "minLength": 1,
          "maxLength": 2000
        },
        "rounds": {
          "type": "integer",
          "title": "讨论轮数",
          "description": "可选；传给讨论会话的最大轮数。",
          "minimum": 1,
          "maximum": 50
        },
        "key": {
          "type": "string",
          "title": "启动键",
          "description": "可选；运行进行中时用相同键重试会返回原运行而不是再启动一次。",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "task"
      ],
      "additionalProperties": false
    }
  },
  {
    "id": "handoff",
    "name": "交接执行",
    "description": "读取讨论成果并把任务交给协作板执行，运行进入执行阶段。",
    "operation": "handoff",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "id": "integrate",
    "name": "整合成果",
    "description": "让整合器生成候选，并沿验收频道广播验收信号。",
    "operation": "integrate",
    "parameters": {
      "type": "object",
      "title": "整合参数",
      "properties": {
        "reason": {
          "type": "string",
          "title": "重开理由",
          "description": "可选；验收阶段发现候选被否决时，作为重开验收的理由传给整合器；缺省为“成员否决后重开验收”。",
          "maxLength": 500
        }
      },
      "additionalProperties": false
    }
  },
  {
    "id": "promote",
    "name": "发布成果",
    "description": "全员认可后发布当前候选，运行标记为完成。",
    "operation": "promote",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "id": "status",
    "name": "查看状态",
    "description": "查看讨论、协作板与整合器状态及最近错误，不读取历史运行。",
    "operation": "status",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "id": "stop",
    "name": "停止任务",
    "description": "按当前阶段停止讨论会话或关闭协作板，运行保留为已停止。",
    "operation": "stop",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "title": "停止原因",
          "maxLength": 500
        }
      },
      "additionalProperties": false
    }
  }
]
