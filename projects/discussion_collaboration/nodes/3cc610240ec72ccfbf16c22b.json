                  "round": {
                    "type": "integer",
                    "title": "轮次",
                    "description": "可选；省略时按调用时的当前轮处理，显式填写时必须与当前轮一致。",
                    "minimum": 1,
                    "maximum": 20
                  },
                  "key": {
                    "type": "string",
                    "title": "去重键",
                    "description": "可选；同一运行、成员、轮次内的相同键与相同正文只记录一次。",
                    "minLength": 1
