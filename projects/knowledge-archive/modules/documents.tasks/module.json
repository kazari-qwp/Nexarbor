{
  "format": "nexarbor-module/v3",
  "id": "documents.tasks",
  "version": "2.0.0",
  "name": "任务与交付文档",
  "description": "保存原始任务、修订交付和真实来源/回执。",
  "entry": "module.py:execute",
  "node_types": [
    "node",
    "agent"
  ],
  "requires": [],
  "config_schema": {
    "type": "object",
    "properties": {
      "input": {
        "type": "string",
        "format": "node-id"
      },
      "output": {
        "type": "string",
        "format": "node-id"
      }
    },
    "required": [
      "input",
      "output"
    ],
    "additionalProperties": false
  },
  "state_schema": {
    "type": "object",
    "additionalProperties": true
  },
  "operations": [
    {
      "name": "task_document_read",
      "channels": [
        "self",
        "documents"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "result": {}
    },
    {
      "name": "task_document_write",
      "channels": [
        "self",
        "documents"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "node_id": {
                  "type": "string"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "locator": {
                  "type": "string"
                }
              },
              "required": [
                "node_id"
              ],
              "additionalProperties": false
            }
          },
          "receipts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "content"
        ],
        "additionalProperties": false
      },
      "result": {}
    },
    {
      "name": "current",
      "channels": [
        "self"
      ],
      "parameters": {
        "type": "object",
        "additionalProperties": true
      },
      "result": {}
    },
    {
      "name": "begin",
      "channels": [
        "self"
      ],
      "parameters": {
        "type": "object",
        "additionalProperties": true
      },
      "result": {}
    },
    {
      "name": "reference",
      "channels": [
        "self"
      ],
      "parameters": {
        "type": "object",
        "additionalProperties": true
      },
      "result": {}
    },
    {
      "name": "remember",
      "channels": [
        "self"
      ],
      "parameters": {
        "type": "object",
        "additionalProperties": true
      },
      "result": {}
    }
  ],
  "agent_tools": [
    {
      "id": "task_document_read",
      "name": "task_document_read",
      "description": "读取原始任务或交付文档。",
      "operation": "task_document_read"
    },
    {
      "id": "task_document_write",
      "name": "task_document_write",
      "description": "更新自己的交付文档，记录结果与依据。",
      "operation": "task_document_write"
    }
  ],
  "signals": []
}
