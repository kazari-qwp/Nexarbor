{
  "format": "nexarbor-module/v3",
  "id": "discussion.session.rev_697d80a33d",
  "name": "讨论会话",
  "version": "0.1.3",
  "description": "一组讨论的运行与协议中心：发现 discussion.seat 席位，管理运行身份、轮次、完整发言、Leader 决策、Recorder 草稿与最终成果，以及停止、重开、成员退出和失败报告。只按频道发现席位并用信号驱动，不直接运行模型或拼装提示词。",
  "entry": "module.py:execute",
  "node_types": [
    "node"
  ],
  "requires": [],
  "config_schema": {
    "type": "object",
    "title": "讨论会话配置",
    "additionalProperties": false,
    "properties": {
      "rounds": {
        "type": "integer",
        "title": "讨论轮次",
        "description": "一次运行需要完成的讨论轮数，范围 1 到 20，默认 3。",
        "minimum": 1,
        "maximum": 20,
        "default": 3
      },
      "max_speech_chars": {
        "type": "integer",
        "title": "单条发言上限",
        "description": "每条发言允许的最大字符数，范围 100 到 8000，默认 4000。",
        "minimum": 100,
        "maximum": 8000,
        "default": 4000
      },
      "max_speeches": {
        "type": "integer",
        "title": "保留发言条数",
        "description": "当前运行最多保留的完整发言条数，超出后删除最旧的发言，范围 10 到 5000，默认 500。",
        "minimum": 10,
        "maximum": 5000,
        "default": 500
      },
      "max_runs": {
        "type": "integer",
        "title": "历史运行保留数",
        "description": "状态中保留的最近运行摘要条数，范围 1 到 50，默认 20。",
        "minimum": 1,
        "maximum": 50,
        "default": 20
      },
      "member_channel": {
        "type": "array",
        "title": "参与者发现频道",
        "description": "用于发现 discussion.seat 席位并调用 describe 的频道；默认 discussion.member。",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true,
        "minItems": 1,
        "default": [
          "discussion"
        ]
      },
      "channel_modes": {
        "type": "object",
        "title": "频道模式",
        "description": "按频道名声明 allow 或 deny，与当前授权相交后再用于参与者发现。",
        "additionalProperties": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "default": {}
      },
      "activity_timeout_seconds": {
        "type": "integer",
        "title": "信号处理时限（秒）",
        "description": "该模块发出的每轮信号及单个目标的有限处理时限；应能容纳模型读取资料、执行与验证。",
        "minimum": 1,
        "maximum": 86400,
        "default": 86400
      }
    }
  },
