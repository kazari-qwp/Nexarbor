{
  "node_read": {
    "name": "node_read",
    "description": "从所属节点出发读取网络数据，仍检查接口权限。文本用method=key,key=content；可以选target筛选可达目标。",
    "parameters": {
      "type": "object",
      "properties": {
        "request": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "key",
                "filter",
                "semantic"
              ]
            },
            "key": {
              "type": "string"
            },
            "filters": {
              "type": "object"
            },
            "query": {
              "type": "string"
            },
            "top_k": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "method"
          ],
          "additionalProperties": false,
          "description": "文本节点读取必须使用 {\"method\":\"key\",\"key\":\"content\"}。filter需filters，semantic需query；不要混用字段。"
        },
        "target": {
          "type": "string"
        },
        "strength": {
          "type": "number",
          "minimum": 0
        },
        "scope": {
          "type": "string",
          "enum": [
            "local",
            "network"
          ]
        }
      },
      "required": [
        "request"
      ],
      "additionalProperties": false
    }
  },
  "node_write": {
    "name": "node_write",
    "description": "从所属节点出发向可写目标写入。",
    "parameters": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "value": {},
        "mode": {
          "type": "string",
          "enum": [
            "upsert",
            "append"
          ]
        },
        "strength": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "target",
        "key",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "network_structure": {
    "name": "network_structure",
    "description": "从所属节点查看连接摘要，默认使用最大depth，起点第0层，每个接口计1层；最大depth=100表示查看全部获准拓扑。只查看结构，不扩大数据或操作权限。",
    "parameters": {
      "type": "object",
      "properties": {
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "direction": {
          "type": "string",
          "enum": [
            "read",
            "write",
            "both"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "node_list": {
    "name": "node_list",
    "description": "发现所属节点可达的节点。",
    "parameters": {
      "type": "object",
      "properties": {
        "strength": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "node_tools": {
    "name": "node_tools",
    "description": "该节点向你暴露允许你使用的工具，这并不是该节点的工具列表",
    "parameters": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "strength": {
          "type": "number",
          "minimum": 0
        },
        "direction": {
          "type": "string",
          "enum": [
            "read",
            "write"
          ]
        }
      },
      "required": [
        "target"
      ],
      "additionalProperties": false
    }
  },
  "node_invoke": {
    "name": "node_invoke",
    "description": "按已发现定义调用可达节点工具。",
    "parameters": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "arguments": {
          "type": "object"
        },
        "strength": {
          "type": "number",
          "minimum": 0
        },
        "direction": {
          "type": "string",
          "enum": [
            "read",
            "write"
          ]
        }
      },
      "required": [
        "target",
        "tool",
        "arguments"
      ],
      "additionalProperties": false
    }
  }
}