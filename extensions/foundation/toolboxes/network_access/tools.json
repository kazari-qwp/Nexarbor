{
  "node_read": {
    "name": "node_read",
    "description": "沿 access.read 频道读取可达数据。文本用 method=key,key=content；可选 target 筛选目标。",
    "parameters": {
      "type": "object",
      "properties": {
        "request": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "key",
                "filter",
                "semantic"
              ]
            },
            "key": {
              "type": "string"
            },
            "filters": {
              "type": "object"
            },
            "query": {
              "type": "string"
            },
            "top_k": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "method"
          ],
          "additionalProperties": false,
          "description": "文本节点读取必须使用 {\"method\":\"key\",\"key\":\"content\"}。filter需filters，semantic需query；不要混用字段。"
        },
        "target": {
          "type": "string"
        },
        "strength": {
          "type": "number",
          "minimum": 0
        },
        "scope": {
          "type": "string",
          "enum": [
            "local",
            "network"
          ]
        }
      },
      "required": [
        "request"
      ],
      "additionalProperties": false
    }
  },
  "node_write": {
    "name": "node_write",
    "description": "沿 access.write 频道向指定可达节点写入数据。",
    "parameters": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "value": {},
        "mode": {
          "type": "string",
          "enum": [
            "upsert",
            "append"
          ]
        },
        "strength": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "target",
        "key",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "network_structure": {
    "name": "network_structure",
    "description": "从所属节点查看连接摘要，默认使用最大depth，起点第0层，每个接口计1层；最大depth=100表示查看全部获准拓扑。只查看结构，不扩大数据或操作权限。",
    "parameters": {
      "type": "object",
      "properties": {
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "概况查询采用的频道，默认 access.read 与 access.write；不会授予工具权限。"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "node_list": {
    "name": "node_list",
    "description": "发现所属节点可达的节点。",
    "parameters": {
      "type": "object",
      "properties": {
        "strength": {
          "type": "number",
          "minimum": 0
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "概况查询采用的频道，默认 access.read 与 access.write；不会授予工具权限。"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "node_tools": {
    "name": "node_tools",
    "description": "查看目标向你开放的工具及参数；框架按各工具声明的频道检查权限，无需指定读写方向。",
    "parameters": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "strength": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "target"
      ],
      "additionalProperties": false
    }
  },
  "node_invoke": {
    "name": "node_invoke",
    "description": "按已发现的定义调用节点工具。频道由工具声明决定，框架重新检查当前路径与强度。",
    "parameters": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "arguments": {
          "type": "object"
        },
        "strength": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "target",
        "tool",
        "arguments"
      ],
      "additionalProperties": false
    }
  }
}