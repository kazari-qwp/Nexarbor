{
  "format": "nexarbor-module/v3",
  "id": "modules.executor",
  "version": "0.1.0",
  "entry": "module.py:execute",
  "node_types": [
    "node",
    "agent",
    "text_file",
    "pulse"
  ],
  "requires": [],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "operations",
      "graphs"
    ],
    "$defs": {
      "plan": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id",
              "operation",
              "arguments"
            ],
            "properties": {
              "type": {
                "const": "call",
                "title": "步骤类型"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "title": "步骤编号"
              },
              "operation": {
                "type": "string",
                "minLength": 1,
                "title": "操作"
              },
              "arguments": {
                "type": "object",
                "title": "参数"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "steps"
            ],
            "properties": {
              "type": {
                "enum": [
                  "sequence",
                  "parallel"
                ],
                "title": "步骤类型"
              },
              "steps": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/plan"
                },
                "title": "执行步骤"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "select",
              "cases",
              "default"
            ],
            "properties": {
              "type": {
                "const": "branch",
                "title": "步骤类型"
              },
              "select": {
                "type": "object",
                "required": [
                  "$ref"
                ],
                "additionalProperties": false,
                "properties": {
                  "$ref": {
                    "type": "string",
                    "pattern": "^/"
                  }
                },
                "title": "分支依据"
              },
              "cases": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "$ref": "#/$defs/plan"
                },
                "title": "分支映射"
              },
              "default": {
                "$ref": "#/$defs/plan",
                "title": "默认分支"
              }
            }
          }
        ]
      }
    },
    "properties": {
      "operations": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "module",
            "operation"
          ],
          "properties": {
            "node": {
              "type": "string",
              "minLength": 1,
              "title": "目标节点"
            },
            "module": {
              "type": "string",
              "minLength": 1,
              "title": "模块"
            },
            "operation": {
              "type": "string",
              "minLength": 1,
              "title": "操作"
            },
            "channels": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "title": "频道"
            },
            "strength": {
              "type": "number",
              "minimum": 0,
              "title": "强度"
            },
            "require_success": {
              "type": "boolean",
              "default": true,
              "title": "要求执行成功"
            }
          }
        },
        "title": "操作映射"
      },
      "graphs": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "$ref": "#/$defs/plan"
        },
        "title": "执行图"
      },
      "default_graph": {
        "type": "string",
        "minLength": 1,
        "title": "默认执行图"
      },
      "signal_channels": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        },
        "title": "响应频道"
      },
      "timeout_seconds": {
        "type": "number",
        "minimum": 0.01,
        "maximum": 300,
        "default": 60,
        "title": "执行超时（秒）"
      },
      "on_signal": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "graph"
          ],
          "properties": {
            "graph": {
              "type": "string",
              "minLength": 1,
              "title": "执行图名称"
            },
            "kind": {
              "type": "string",
              "minLength": 1,
              "title": "信号种类"
            },
            "channels": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "title": "频道"
            },
            "where": {
              "type": "object",
              "propertyNames": {
                "pattern": "^/"
              },
              "title": "匹配条件"
            }
          }
        },
        "title": "信号执行规则"
      }
    },
    "title": "模块流程配置"
  },
  "state_schema": {
    "type": "object",
    "additionalProperties": false,
    "title": "模块状态"
  },
  "signals": {
    "config": "signal_channels"
  },
  "operations": [
    {
      "name": "run",
      "channels": [
        "workflow"
      ],
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "graph": {
            "type": "string",
            "minLength": 1,
            "title": "执行图名称"
          },
          "input": {
            "title": "输入内容"
          }
        }
      },
      "result": {
        "type": "object"
      }
    }
  ],
  "name": "模块流程执行器",
  "description": "通过可配置执行图按顺序、分支或并行调用模块。"
}
