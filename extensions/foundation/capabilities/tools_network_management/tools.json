{
  "datanet_create_agent": {
    "name": "datanet_create_agent",
    "description": "创建 Agent 节点，自动配备独立会话、个人记忆和读写工具；配置匹配时复用当前网络池中的 Agent。",
    "parameters": {
      "type": "object",
      "properties": {
        "preset": {
          "type": "string",
          "enum": [
            "worker"
          ]
        },
        "prompt": {
          "type": "string"
        },
        "toolboxes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": []
          },
          "uniqueItems": true
        },
        "max_signal_strength": {
          "type": "number",
          "minimum": 0
        },
        "child_id": {
          "type": "string"
        },
        "parent_node_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "child_id"
      ],
      "additionalProperties": false
    }
  },
  "datanet_call_agent": {
    "name": "datanet_call_agent",
    "description": "向获准的下属 Agent 异步委托任务，立即返回委托 ID；同一 Agent 按提交顺序执行，结果由框架回送。",
    "parameters": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "strength": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "target",
        "task"
      ],
      "additionalProperties": false
    }
  },
  "datanet_manage_agent": {
    "name": "datanet_manage_agent",
    "description": "查看或调整获准 Agent 的提示词与会话。",
    "parameters": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": [
            "inspect",
            "update_prompt",
            "restart",
            "clear_context"
          ]
        },
        "prompt": {
          "type": "string"
        }
      },
      "required": [
        "target",
        "action"
      ],
      "additionalProperties": false
    }
  },
  "datanet_agent_capabilities": {
    "name": "datanet_agent_capabilities",
    "description": "查看宿主允许为子 Agent 装配的工具箱。工具箱私有，不可跨 Agent 调用工具或 Skill。",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  "datanet_presets": {
    "name": "datanet_presets",
    "description": "查看预设与已保存的离线网络；指定 ID 查看对应说明或保存清单。",
    "parameters": {
      "type": "object",
      "properties": {
        "archived_network_id": {
          "type": "string"
        },
        "preset": {
          "type": "string",
          "enum": [
            "discussion_group",
            "number_network"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "datanet_interfaces": {
    "name": "datanet_interfaces",
    "description": "管理获准节点的链接；拆除导致节点与根断联时，确认取消、保存结构或分解进入复用池。",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "list",
            "add",
            "update",
            "remove"
          ]
        },
        "arguments": {
          "type": "object",
          "properties": {
            "node_id": {
              "type": "string"
            },
            "target_node_id": {
              "type": "string",
              "description": "add/update/remove必填；即便提供interface_index也须填写，用来核验目标。"
            },
            "interface": {
              "type": "object",
              "properties": {
                "metadata": {
                  "type": "object",
                  "properties": {
                    "visibility": {
                      "type": "string",
                      "enum": [
                        "public",
                        "private"
                      ],
                      "default": "public"
                    },
                    "threshold": {
                      "type": "integer",
                      "minimum": 0,
                      "default": 0
                    },
                    "multiplier": {
                      "type": "number",
                      "minimum": 0,
                      "default": 1
                    },
                    "channels": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true,
                      "default": []
                    },
                    "attributes": {
                      "type": "object"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "metadata"
              ],
              "additionalProperties": false
            },
            "changes": {
              "type": "object",
              "properties": {
                "metadata": {
                  "type": "object",
                  "properties": {
                    "visibility": {
                      "type": "string",
                      "enum": [
                        "public",
                        "private"
                      ],
                      "default": "public"
                    },
                    "threshold": {
                      "type": "integer",
                      "minimum": 0,
                      "default": 0
                    },
                    "multiplier": {
                      "type": "number",
                      "minimum": 0,
                      "default": 1
                    },
                    "channels": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true,
                      "default": []
                    },
                    "attributes": {
                      "type": "object"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "metadata"
              ],
              "additionalProperties": false
            },
            "interface_index": {
              "type": "integer",
              "minimum": 0
            },
            "confirmation_id": {
              "type": "string"
            },
            "choice": {
              "type": "integer",
              "enum": [
                1,
                2,
                3
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "action",
        "arguments"
      ],
      "additionalProperties": false
    }
  },
  "datanet_create_node": {
    "name": "datanet_create_node",
    "description": "创建数据或组织子节点，可选择预设或自定义受支持类型。",
    "parameters": {
      "type": "object",
      "properties": {
        "child_id": {
          "type": "string"
        },
        "node_spec": {
          "type": "object"
        },
        "parent_node_id": {
          "type": "string"
        },
        "interface": {
          "type": "object",
          "properties": {
            "metadata": {
              "type": "object",
              "properties": {
                "visibility": {
                  "type": "string",
                  "enum": [
                    "public",
                    "private"
                  ],
                  "default": "public"
                },
                "threshold": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 0
                },
                "multiplier": {
                  "type": "number",
                  "minimum": 0,
                  "default": 1
                },
                "channels": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "default": []
                },
                "attributes": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "metadata"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "child_id",
        "node_spec"
      ],
      "additionalProperties": false
    }
  },
  "datanet_create_network": {
    "name": "datanet_create_network",
    "description": "按预设创建网络，返回实际节点ID与连接摘要。",
    "parameters": {
      "type": "object",
      "properties": {
        "preset": {
          "type": "string",
          "enum": [
            "discussion_group",
            "number_network"
          ]
        },
        "instance_id": {
          "type": "string"
        },
        "parent_node_id": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "project_nodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "with_agents": {
          "type": "boolean"
        },
        "rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "member_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "description": "普通成员数量；讨论组不含 Leader 和 Recorder，默认3；去中心化组默认4。"
        }
      },
      "required": [
        "preset",
        "instance_id"
      ],
      "additionalProperties": false
    }
  }
}