{
  "format": "nexarbor-module/v3",
  "version": "0.1.0",
  "entry": "module.py:execute",
  "signals": [],
  "id": "movement.here",
  "name": "移动到此",
  "description": "锁定 NPC、旧地点和目的地，原子更新双向位置连接及地点资料；可配置移动前钩子与新位置边频道，并在结果中按序返回钩子观察。",
  "node_types": [
    "node",
    "text_file"
  ],
  "requires": [
    "place.info"
  ],
  "config_schema": {
    "type": "object",
    "title": "移动到此配置",
    "properties": {
      "timeout_seconds": {
        "type": "number",
        "minimum": 1,
        "maximum": 120,
        "default": 15,
        "title": "移动超时（秒）"
      },
      "location_channels": {
        "type": "array",
        "title": "新位置边频道",
        "description": "移动成功后，NPC 与目的地之间新建双向位置边使用的访问频道。必须是非空、不重复的字符串数组，且包含 movement；默认只保留 movement、tools。需要到达后继续访问本地业务时，按模块访问授权填写 records、info、service 等频道。不要填写仅供节点自身的 self 频道。",
        "default": [
          "movement",
          "tools"
        ],
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "self"
          }
        },
        "contains": {
          "const": "movement"
        }
      },
      "before_hooks": {
        "type": "array",
        "title": "移动前钩子",
        "description": "位置与道路检查通过后、修改任何位置数据前，按顺序调用已锁定目标上的模块操作；任一步失败则整次移动回滚。默认空数组，不产生额外依赖。",
        "default": [],
        "items": {
          "type": "object",
          "title": "移动前钩子项",
          "properties": {
            "target": {
              "type": "string",
              "title": "目标节点",
              "description": "requester 表示发起移动的 Agent，origin 表示旧地点，destination 表示目的地。",
              "enum": [
                "requester",
                "origin",
                "destination"
              ],
              "default": "requester"
            },
            "module": {
              "type": "string",
              "title": "模块标识",
              "description": "要调用的模块 ID，例如 records.store。",
              "minLength": 1
            },
            "operation": {
              "type": "string",
              "title": "操作名称",
              "description": "目标模块公开的操作名称，例如 apply。",
              "minLength": 1
            },
            "arguments": {
              "type": "object",
              "title": "调用参数",
              "description": "传给目标模块操作的 JSON 对象。",
              "additionalProperties": true,
              "default": {}
            }
          },
          "required": [
            "target",
            "module",
            "operation"
          ],
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "state_schema": {
    "type": "object",
    "additionalProperties": false
  },
  "operations": [
    {
      "name": "move",
      "channels": [
        "movement"
      ],
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "title": "移动结果",
        "properties": {
          "moved": {
            "type": "boolean",
            "title": "是否发生移动"
          },
          "from_location": {
            "type": "string",
            "title": "原地点"
          },
          "location": {
            "type": "string",
            "title": "当前地点"
          },
          "description": {
            "type": "string",
            "title": "目的地说明"
          },
          "before_results": {
            "type": "array",
            "title": "移动前钩子结果",
            "description": "按配置顺序记录每个成功调用的目标、模块、操作和原样 JSON 数据；没有钩子或未发生移动时为空数组。任一项失败则整次移动回滚，不返回部分结果。",
            "items": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "string",
                  "enum": [
                    "requester",
                    "origin",
                    "destination"
                  ],
                  "title": "钩子目标"
                },
                "module": {
                  "type": "string",
                  "title": "模块标识"
                },
                "operation": {
                  "type": "string",
                  "title": "操作名称"
                },
                "data": {
                  "title": "调用结果",
                  "description": "目标操作成功返回的 JSON 数据副本。"
                }
              },
              "required": [
                "target",
                "module",
                "operation",
                "data"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "moved",
          "location",
          "before_results"
        ],
        "additionalProperties": false
      }
    }
  ],
  "agent_tools": [
    {
      "id": "move_here",
      "name": "移动到此",
      "description": "沿相邻道路移动到提供此工具的地点。",
      "operation": "move"
    }
  ]
}
