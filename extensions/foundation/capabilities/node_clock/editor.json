{
  "clock.text": {
    "label": "时间文本",
    "schema": {
      "title": "",
      "type": "object",
      "properties": {
        "channels": {
          "title": "频道",
          "type": "array",
          "items": {
            "title": "",
            "type": "string"
          }
        },
        "slots": {
          "title": "时刻名称",
          "type": "array",
          "items": {
            "title": "",
            "type": "string"
          },
          "minItems": 1
        },
        "format": {
          "title": "格式",
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "channels",
        "slots",
        "format"
      ]
    },
    "stateSchema": {
      "title": "",
      "type": "object",
      "properties": {
        "tick": {
          "title": "tick",
          "type": "integer"
        },
        "signal_id": {
          "title": "signal_id",
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "defaults": {
      "config": {
        "channels": [
          "world.tick"
        ],
        "slots": [
          "早",
          "午",
          "下午",
          "傍晚",
          "午夜"
        ],
        "format": "第{day}天-{slot}"
      },
      "state": {
        "tick": -1,
        "signal_id": null
      }
    }
  }
}
