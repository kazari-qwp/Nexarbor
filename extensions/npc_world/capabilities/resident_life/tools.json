{
  "talk": {
    "description": "向同场所的此人说话。",
    "parameters": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "content"
      ],
      "additionalProperties": false
    }
  },
  "give": {
    "description": "赠送物品或钱给同场所的此人。",
    "parameters": {
      "type": "object",
      "properties": {
        "item": {
          "type": "string",
          "enum": [
            "coins",
            "wood",
            "ore"
          ]
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
        "item",
        "quantity"
      ],
      "additionalProperties": false
    }
  }
}
