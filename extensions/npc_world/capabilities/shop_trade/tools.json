{
  "trade": {
    "description": "在商店买卖木材、矿石或工具。",
    "parameters": {
      "type": "object",
      "properties": {
        "side": {
          "type": "string",
          "enum": [
            "buy",
            "sell"
          ]
        },
        "item": {
          "type": "string",
          "enum": [
            "wood",
            "ore",
            "axe",
            "pickaxe"
          ]
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [
        "side",
        "item",
        "quantity"
      ],
      "additionalProperties": false
    }
  }
}
