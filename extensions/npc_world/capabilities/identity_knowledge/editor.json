                  }
                },
                "additionalProperties": true
              },
              "file": {
                "title": "组件内文件",
                "type": "string"
              },
              "delivery": {
                "title": "delivery",
                "type": "string"
              },
              "node_id": {
                "title": "node_id",
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "stateSchema": {
