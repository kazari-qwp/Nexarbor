{
  "world_look": {
    "description": "查看自己的状态、当前场所、邻居和上次结算。",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "name": "world_look"
  },
  "world_messages": {
    "description": "读取同场所居民留给自己的未读交谈。",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "name": "world_messages"
  },
  "world_submit": {
    "description": "提交本时刻的行动计划；未选行动则等待。",
    "parameters": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "name": "world_submit"
  },
  "world_observe": {
    "description": "观察小镇地图、居民会话和最近结算。",
    "parameters": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "name": "world_observe"
  },
  "world_round": {
    "description": "开启、结算或运行一个小镇时刻；run会并行启动所有居民。",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "begin",
            "settle",
            "run",
            "cancel"
          ]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "name": "world_round"
  },
  "world_run_npc": {
    "description": "仅运行指定居民本时刻的行动，供局部观察与测试。",
    "parameters": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        }
      },
      "required": [
        "target"
      ],
      "additionalProperties": false
    },
    "name": "world_run_npc"
  }
}
