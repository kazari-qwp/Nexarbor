{
  "incident_query": {
    "name": "incident_query",
    "description": "查询自动收集的阻塞和执行异常，包括未解决现象与重试记录；它们不是已验证经验。",
    "parameters": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "all",
            "unresolved",
            "resolved"
          ]
        },
        "node_id": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "incident_resolve": {
    "name": "incident_resolve",
    "description": "报告者、管理者或获授权经验维护者可标记阻塞已解决。必须提供该节点在报错后正常完成的retry_run_id和具体结果依据；补工具或改提示词本身不能证明解决。可关联待审核或已验证经验ID。",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "retry_run_id": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "experience_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "retry_run_id",
        "evidence"
      ],
      "additionalProperties": false
    }
  }
}