{
  "datanet_cooperate": {
    "name": "datanet_cooperate",
    "description": "启动、查看或停止去中心化协作小组。",
    "parameters": {
      "type": "object",
      "properties": {
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "start",
            "status",
            "stop"
          ]
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "budget_minutes": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1440
        }
      },
      "required": [
        "group_id",
        "action"
      ],
      "additionalProperties": false
    }
  },
  "datanet_team_status": {
    "name": "datanet_team_status",
    "description": "按需查看本组认领、共享记录或验收材料。",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "section": {
          "type": "string",
          "enum": [
            "all",
            "summary",
            "claims",
            "records",
            "candidate"
          ],
          "default": "all",
          "description": "选择要读取的内容。"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "datanet_team_claim": {
    "name": "datanet_team_claim",
    "description": "认领子任务及文件路径、补充路径，或完成、释放自己的认领。",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "claim",
            "extend",
            "complete",
            "release"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "description": "预计添加、修改或删除的工作区相对文件或目录路径；调查任务可省略。extend 时补充原认领的路径。",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    }
  },
  "datanet_team_note": {
    "name": "datanet_team_note",
    "description": "向本组共享记录发布发现、事实、失败尝试或成果摘要。",
    "parameters": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "OBSERVED",
            "FACT",
            "FAIL",
            "PATCH_SUMMARY"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "content"
      ],
      "additionalProperties": false
    }
  },
  "datanet_team_send": {
    "name": "datanet_team_send",
    "description": "向本组其他成员发信；运行中插话，空闲时唤醒。",
    "parameters": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "message_type": {
          "type": "string",
          "enum": [
            "work_order",
            "reply"
          ],
          "default": "work_order",
          "description": "work_order 需要答复；reply 可不回复。"
        }
      },
      "required": [
        "target",
        "content"
      ],
      "additionalProperties": false
    }
  },
  "datanet_team_workspace": {
    "name": "datanet_team_workspace",
    "description": "查看个人工作目录、同步共同成果或提交并整合修改。",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "inspect",
            "sync",
            "publish"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    }
  },
  "datanet_team_finish": {
    "name": "datanet_team_finish",
    "description": "提交成果与验收材料，或批准、否决当前候选。",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "propose",
            "approve",
            "reject"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "test_scripts": {
          "type": "array",
          "description": "已提交的测试脚本在共同工作区中的相对路径。",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "test_results": {
          "type": "array",
          "description": "自己的测试结果文件路径。",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "log_ids": {
          "type": "array",
          "description": "附上的终端日志ID；省略时附上自己本次运行的日志。",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "action",
        "evidence"
      ],
      "additionalProperties": false
    }
  }
}