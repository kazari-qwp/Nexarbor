{
  "kind": "network",
  "version": 1,
  "id": "experiment_analysis",
  "description": "实验分析拼图，组合 CSV 记录与 SQLite 规则。",
  "network": {
    "version": 6,
    "nodes": [
      {
        "type": "agent",
        "node_id": "root",
        "name": "实验项目入口",
        "data_kind": "agent",
        "parameters": {
          "file_path": "root_memory.md"
        },
        "connections": {
          "interfaces": [
            {
              "target_node_id": "lab_rules",
              "metadata": {
                "channels": [
                  "access.read"
                ],
                "threshold": 0,
                "visibility": "public",
                "multiplier": 1
              }
            },
            {
              "target_node_id": "lab_records",
              "metadata": {
                "channels": [
                  "access.read"
                ],
                "threshold": 0,
                "visibility": "public",
                "multiplier": 1
              }
            }
          ]
        },
        "agent": {
          "package": "../../../../../../../nodes/agent_experiment_report/python/datanet/components/agents/experiment_report"
        },
        "description": "组合实验规则与记录，计算项目合格率并提供数据来源。",
        "divergence": -1,
        "toolboxes": [],
        "expose": [
          "analyze_project"
        ],
        "management_parent_id": null
      },
      {
        "type": "sqlite",
        "node_id": "lab_rules",
        "name": "实验规则",
        "data_kind": "experiment_rule",
        "parameters": {
          "db_path": "data/lab.db",
          "table_name": "rules",
          "key_column": "project_id"
        },
        "connections": {
          "interfaces": []
        },
        "agent": null,
        "description": "保存项目 A/B/C 的合格判定规则，按项目编号查询。",
        "divergence": -1,
        "toolboxes": [
          "local_data"
        ],
        "expose": [
          "read",
          "get_schema",
          "write"
        ],
        "management_parent_id": "root"
      },
      {
        "type": "csv",
        "node_id": "lab_records",
        "name": "实验记录",
        "data_kind": "experiment_record",
        "parameters": {
          "file_path": "data/实验记录01/01.csv",
          "key_column": "记录编号",
          "dtype": {
            "记录编号": "string",
            "项目": "string",
            "测量值": "Int64",
            "是否有效": "string"
          }
        },
        "connections": {
          "interfaces": []
        },
        "agent": null,
        "description": "保存模拟实验记录，支持按记录编号读取和字段等值筛选。",
        "divergence": -1,
        "toolboxes": [
          "local_data"
        ],
        "expose": [
          "read",
          "get_schema",
          "write"
        ],
        "management_parent_id": "root"
      }
    ],
    "delegations": [],
    "signals": {}
  },
  "entry_points": {
    "root": "root",
    "rules": "lab_rules",
    "records": "lab_records"
  },
  "toolkits": {
    "root": [
      "experiment_analysis"
    ]
  }
}
