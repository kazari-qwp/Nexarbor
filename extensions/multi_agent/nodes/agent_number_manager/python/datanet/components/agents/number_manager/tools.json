[
  {
    "type": "function",
    "function": {
      "name": "describe_node",
      "description": "查看指定节点的用途、数据类别、动态 schema、是否配置 Agent、本地工具名及有向接口及频道元数据。返回结构信息，不返回记录值。",
      "parameters": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string",
            "description": "已注册节点编号，例如 n1。"
          }
        },
        "required": [
          "node_id"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "read",
      "description": "默认从所属节点读取；scope 为 local 或 network，strength 默认 0，路径强度需满足各接口门槛。",
      "parameters": {
        "type": "object",
        "properties": {
          "request": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "key",
                  "filter",
                  "semantic"
                ]
              },
              "key": {
                "type": "string"
              },
              "filters": {
                "type": "object"
              },
              "query": {
                "type": "string"
              },
              "top_k": {
                "type": "integer"
              }
            },
            "required": [
              "method"
            ],
            "additionalProperties": false,
            "description": "key 方法必须提供 key；filter 方法必须提供 filters；semantic 必须提供 query，可选 top_k。不得混用字段。"
          },
          "node_id": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "local",
              "network"
            ]
          },
          "data_kind": {
            "type": "string"
          },
          "strength": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "request"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "write",
      "description": "从所属节点沿 access.write 频道定向写入；strength 默认 0，可显式选择起点。private 不因强度增加而开放。",
      "parameters": {
        "type": "object",
        "properties": {
          "target_node_id": {
            "type": "string",
            "description": "目标节点编号，如 n2。"
          },
          "key": {
            "type": "string",
            "description": "数字节点固定为 value。"
          },
          "value": {
            "type": "number",
            "description": "写入的数字。"
          },
          "mode": {
            "type": "string",
            "enum": [
              "insert",
              "update",
              "upsert"
            ]
          },
          "strength": {
            "type": "integer",
            "minimum": 0
          },
          "node_id": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "local",
              "network"
            ]
          }
        },
        "required": [
          "target_node_id",
          "key",
          "value",
          "mode"
        ],
        "additionalProperties": false
      }
    }
  }
]