{
  "format": "nexarbor-module/v1",
  "id": "chance.events",
  "version": "1.0.0",
  "entry": "module.py:Module",
  "node_types": [
    "node"
  ],
  "requires": [],
  "config_schema": {
    "type": "object",
    "properties": {
      "events": {
        "type": "array",
        "description": "概率事件定义。每个事件的触发动作、概率和命中上限互相独立。",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "事件标识，在同一配置内唯一；命中次数以它作为状态键。"
            },
            "triggers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "触发动作列表。draw 的 trigger 等于其中任一项时，该事件参与本次抽取。"
            },
            "probability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "事件的独立固定概率；0 永不命中，1 必定命中。"
            },
            "max_hits": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "最多命中次数；null 表示无限。0 表示从一开始就不再抽取。"
            },
            "message": {
              "type": "string",
              "description": "命中时随结果返回的文字。"
            },
            "effects": {
              "description": "可选的任意 JSON 值，命中时原样（深拷贝）随结果返回。"
            }
          },
          "required": [
            "id",
            "triggers",
            "probability",
            "message"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "events"
    ],
    "additionalProperties": false
  },
  "state_schema": {
    "type": "object",
    "properties": {
      "counts": {
        "type": "object",
        "description": "事件 id 到累计命中次数的映射；只记录命中，未命中的事件不增加计数。",
        "additionalProperties": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "required": [
      "counts"
    ],
    "additionalProperties": false
  },
  "tools": [],
  "signals": [],
  "operations": [
    {
      "name": "draw",
      "parameters": {
        "type": "object",
        "properties": {
          "trigger": {
            "type": "string",
            "minLength": 1,
            "description": "触发动作名称，用来筛选 triggers 包含它的事件。"
          },
          "context": {
            "type": "object",
            "description": "调用方附带的上下文对象；组件接受但不用它改变概率、上限或计数。"
          }
        },
        "required": [
          "trigger"
        ],
        "additionalProperties": false
      }
    }
  ]
}
