{
  "format": "nexarbor-module/v1",
  "id": "time.text",
  "version": "1.0.1",
  "entry": "module.py:Module",
  "node_types": [
    "text_file"
  ],
  "requires": [],
  "config_schema": {
    "type": "object",
    "properties": {
      "slots": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        },
        "description": "一天的时刻表，数组长度就是一天几格，元素就是写入文字。"
      },
      "format": {
        "type": "string",
        "minLength": 1,
        "description": "写入文本节点的模板，可用 {day}、{slot}、{tick}。"
      }
    },
    "required": [
      "slots",
      "format"
    ],
    "additionalProperties": false
  },
  "state_schema": {
    "type": "object",
    "properties": {
      "tick": {
        "type": "integer",
        "minimum": -1,
        "description": "累计推进的总时刻数；-1 表示尚未开始，0 是第 1 天第一个时刻。"
      },
      "last_signal_id": {
        "type": "string",
        "description": "最近计入的时刻对应的信号身份，用于同一信号去重。"
      }
    },
    "required": [
      "tick",
      "last_signal_id"
    ],
    "additionalProperties": false
  },
  "tools": [],
  "signals": [
    "world.tick"
  ],
  "operations": [
    {
      "name": "get_time",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_day",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_tick",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ]
}
