{
  "format": "nexarbor-module/v1",
  "id": "place.move",
  "version": "1.0.1",
  "entry": "module.py:Module",
  "node_types": [
    "node"
  ],
  "requires": [
    "entity.profile",
    "action.points",
    "chance.events"
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "channels"
    ],
    "properties": {
      "channels": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "uniqueItems": true,
        "description": "允许调用 move_here 工具的访问频道；只在这里声明，频道交集与强度由网络核心检查。"
      },
      "place_name": {
        "type": "string",
        "minLength": 1,
        "description": "本地点显示名称，用于工具描述和移动结果；省略时使用挂载节点的名称。"
      },
      "cost": {
        "type": "integer",
        "minimum": 0,
        "description": "进入本地点要消耗的行动值，默认 3。"
      },
      "road_channels": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "uniqueItems": true,
        "description": "表示直接相邻道路的连接频道，默认 [\"road\"]；只有带这些频道之一的连接才被当作道路。"
      },
      "presence_channel": {
        "type": "string",
        "minLength": 1,
        "description": "地点与人物之间的在场连接频道，默认 \"presence\"；移动时只增删这个频道。"
      },
      "entity_module": {
        "type": "string",
        "minLength": 1,
        "description": "人物资料组件 ID，默认 \"entity.profile\"；当前位置写在该组件状态的 profile.place。"
      },
      "action_module": {
        "type": "string",
        "minLength": 1,
        "description": "行动值组件 ID，默认 \"action.points\"；余额不足时拒绝移动。"
      },
      "events_ref": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node",
          "module"
        ],
        "description": "可选的到达事件组件引用；省略时不抽取任何事件，保持原有移动行为。",
        "properties": {
          "node": {
            "type": "string",
            "minLength": 1,
            "description": "挂载 chance.events 实例的节点 ID。"
          },
          "module": {
            "type": "string",
            "minLength": 1,
            "description": "事件组件的模块 ID，通常为 \"chance.events\"。"
          }
        }
      }
    }
  },
  "state_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "tools": [
    {
      "name": "move_here",
      "description": "沿直接相连的道路移动到本地点；工具描述会显示本地点名称与行动值花费。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "channels": {
        "config": "channels"
      }
    }
  ],
  "signals": [],
  "operations": []
}
