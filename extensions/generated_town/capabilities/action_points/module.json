{
  "format": "nexarbor-module/v1",
  "id": "action.points",
  "version": "1.0.0",
  "entry": "module.py:Module",
  "node_types": [
    "agent"
  ],
  "requires": [],
  "config_schema": {
    "type": "object",
    "properties": {
      "max": {
        "type": "integer",
        "minimum": 0,
        "description": "每个新时刻恢复到的行动值上限，默认 10。"
      }
    },
    "additionalProperties": false
  },
  "state_schema": {
    "type": "object",
    "properties": {
      "remaining": {
        "type": "integer",
        "minimum": 0,
        "description": "当前剩余行动值。"
      },
      "last_signal_id": {
        "type": [
          "string",
          "null"
        ],
        "description": "最近计入的新时刻信号身份；同一信号重复投递时用于跳过重置。"
      }
    },
    "required": [
      "remaining",
      "last_signal_id"
    ],
    "additionalProperties": false
  },
  "tools": [],
  "signals": [
    "world.tick"
  ],
  "operations": [
    {
      "name": "get_balance",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "check",
      "parameters": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 0,
            "description": "要检查的消耗点数。"
          }
        },
        "required": [
          "amount"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "spend",
      "parameters": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 0,
            "description": "要扣除的行动值点数。"
          }
        },
        "required": [
          "amount"
        ],
        "additionalProperties": false
      }
    }
  ]
}
