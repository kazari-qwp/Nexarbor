{
  "format": "nexarbor-module/v1",
  "id": "agent.activity",
  "version": "1.0.0",
  "entry": "module.py:Module",
  "node_types": [
    "agent"
  ],
  "requires": [],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "message": {
        "type": "string",
        "minLength": 1,
        "description": "每次收到 world.tick 时，发送给该节点原生 Agent 执行端口的提示语。"
      },
      "max_history": {
        "type": "integer",
        "minimum": 1,
        "description": "保留多少个最近成功处理的 signal_id 用于去重，默认 256。"
      }
    },
    "required": [
      "message"
    ]
  },
  "state_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "processed_signal_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "description": "最近成功执行过的信号身份，按时间从旧到新排列。"
      },
      "last_signal_id": {
        "type": [
          "string",
          "null"
        ],
        "description": "最近一次成功执行对应的 signal_id；从未成功时为 null。"
      },
      "completed_count": {
        "type": "integer",
        "minimum": 0,
        "description": "累计成功执行次数。"
      }
    },
    "required": [
      "processed_signal_ids",
      "last_signal_id",
      "completed_count"
    ]
  },
  "tools": [],
  "signals": [
    "world.tick"
  ],
  "operations": []
}
