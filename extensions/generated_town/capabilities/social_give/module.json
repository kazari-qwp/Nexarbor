{
  "format": "nexarbor-module/v1",
  "id": "social.give",
  "version": "1.0.0",
  "entry": "module.py:Module",
  "node_types": [
    "agent"
  ],
  "requires": [
    "entity.profile",
    "action.points"
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "channels"
    ],
    "properties": {
      "channels": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        },
        "description": "赠送频道的列表；give 工具只对这些频道可达，值必须与接线时使用的频道一致。"
      },
      "presence_channel": {
        "type": "string",
        "minLength": 1,
        "default": "presence",
        "description": "判断“真实双向在场”的连接频道，默认 presence；应与 place.move 的 presence_channel 一致。"
      },
      "action_cost": {
        "type": "integer",
        "minimum": 0,
        "default": 1,
        "description": "每次成功赠送从发送者扣除的行动值，默认 1；0 表示不消耗。"
      },
      "entity_module": {
        "type": "string",
        "minLength": 1,
        "default": "entity.profile",
        "description": "提供 profile、金币与物品的依赖组件 ID，默认 entity.profile。"
      },
      "action_module": {
        "type": "string",
        "minLength": 1,
        "default": "action.points",
        "description": "提供行动值的依赖组件 ID，默认 action.points。"
      },
      "place_field": {
        "type": "string",
        "minLength": 1,
        "default": "place",
        "description": "profile 中表示所在场所的字段名，默认 place。"
      },
      "display_name": {
        "type": "string",
        "minLength": 1,
        "description": "可选：收礼者姓名。仅当挂载时还读不到 profile.name 时用于生成工具描述。"
      }
    }
  },
  "state_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "tools": [
    {
      "name": "give",
      "description": "把你自己拥有的金币或物品送给同场所的收礼者；coins 与 items 至少填一项，成功会消耗行动值。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "coins": {
            "type": "integer",
            "minimum": 1,
            "description": "要送给对方的金币数量，正整数；不送金币时省略。"
          },
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            },
            "description": "要送给对方的物品，键是物品名、值是正整数数量；不送物品时省略。"
          }
        },
        "anyOf": [
          {
            "required": [
              "coins"
            ]
          },
          {
            "required": [
              "items"
            ]
          }
        ]
      },
      "channels": {
        "config": "channels"
      }
    }
  ],
  "signals": [],
  "operations": []
}
