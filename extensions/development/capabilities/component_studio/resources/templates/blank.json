  "module.json": "{\n  \"format\": \"nexarbor-module/v3\",\n  \"id\": \"example.counter\",\n  \"version\": \"0.1.0\",\n  \"entry\": \"module.py:execute\",\n  \"node_types\": [\n    \"node\"\n  ],\n  \"requires\": [],\n  \"config_schema\": {\n    \"type\": \"object\"\n  },\n  \"state_schema\": {\n    \"type\": \"object\"\n  },\n  \"operations\": [\n    {\n      \"name\": \"increment\",\n      \"channels\": [\n        \"demo\"\n      ],\n      \"parameters\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"amount\": {\n            \"type\": \"integer\"\n          }\n        },\n        \"additionalProperties\": false\n      },\n      \"result\": {\n        \"type\": \"integer\"\n      }\n    }\n  ],\n  \"signals\": [\n    \"demo\"\n  ]\n}\n",
