{
  "kb_catalog": {
    "name": "kb_catalog",
    "description": "查找知识集合及其用途、字段和存储类型。",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "kb_create_node": {
    "name": "kb_create_node",
    "description": "创建知识数据集合，自动配置存储和连接。",
    "parameters": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "storage": {
          "type": "string",
          "enum": [
            "csv",
            "sqlite",
            "rag",
            "wiki"
          ]
        },
        "description": {
          "type": "string"
        },
        "schema": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "string",
              "integer",
              "number",
              "boolean",
              "object",
              "array"
            ]
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "storage"
      ],
      "additionalProperties": false
    }
  },
  "kb_store": {
    "name": "kb_store",
    "description": "向指定集合保存资料，或提交已读取的待归档资料。",
    "parameters": {
      "type": "object",
      "properties": {
        "collection": {
          "type": "string"
        },
        "content": {},
        "key": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "intake_id": {
          "type": "string"
        },
        "indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "collection"
      ],
      "additionalProperties": false
    }
  },
  "kb_fetch": {
    "name": "kb_fetch",
    "description": "读取完整原文、文档目录，或展开章节与相邻上下文。",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "view": {
          "enum": [
            "full",
            "outline",
            "section",
            "window"
          ]
        },
        "section_id": {
          "type": "string"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "max_chars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  "kb_search": {
    "name": "kb_search",
    "description": "检索知识入口，返回片段、来源和按需展开的读取参数。",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "collection": {
          "type": "string"
        },
        "filters": {
          "type": "object"
        },
        "semantic": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "kb_update": {
    "name": "kb_update",
    "description": "更新一条知识记录，保留历史版本。",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "content": {},
        "expected_version": {
          "type": "integer"
        },
        "metadata": {
          "type": "object"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "content",
        "expected_version"
      ],
      "additionalProperties": false
    }
  },
  "kb_delete": {
    "name": "kb_delete",
    "description": "删除当前知识记录，保留历史以便追溯。",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "expected_version": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "expected_version"
      ],
      "additionalProperties": false
    }
  },
  "kb_export": {
    "name": "kb_export",
    "description": "导出集合记录，或生成可浏览的Wiki站点。",
    "parameters": {
      "type": "object",
      "properties": {
        "collection": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "json",
            "csv",
            "wiki"
          ]
        }
      },
      "required": [
        "collection"
      ],
      "additionalProperties": false
    }
  },
  "kb_intake": {
    "name": "kb_intake",
    "description": "读取待归档资料及其保存状态。",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  "kb_index": {
    "name": "kb_index",
    "description": "为文档集合更新语义索引。",
    "parameters": {
      "type": "object",
      "properties": {
        "collection": {
          "type": "string"
        },
        "rebuild": {
          "type": "boolean"
        }
      },
      "required": [
        "collection"
      ],
      "additionalProperties": false
    }
  },
  "kb_query": {
    "name": "kb_query",
    "description": "查询数据库集合，支持筛选、排序和分组统计。",
    "parameters": {
      "type": "object",
      "properties": {
        "collection": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filters": {
          "type": "object"
        },
        "group_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "aggregate": {
          "type": "object",
          "properties": {
            "function": {
              "type": "string",
              "enum": [
                "count",
                "sum",
                "avg",
                "min",
                "max"
              ]
            },
            "field": {
              "type": "string"
            }
          },
          "required": [
            "function"
          ],
          "additionalProperties": false
        },
        "order_by": {
          "type": "string"
        },
        "descending": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        }
      },
      "required": [
        "collection"
      ],
      "additionalProperties": false
    }
  },
  "kb_wiki": {
    "name": "kb_wiki",
    "description": "维护 Wiki 时读取操作指南、检索页面或检查链接与过期来源。",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "guide",
            "search",
            "lint"
          ],
          "default": "guide"
        },
        "workflow": {
          "type": "string",
          "enum": [
            "ingest",
            "query",
            "lint"
          ]
        },
        "collection": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "additionalProperties": false
    }
  }
}
