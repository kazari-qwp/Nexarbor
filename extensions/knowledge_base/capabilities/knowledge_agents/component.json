{
  "id": "capabilities/knowledge_agents",
  "kind": "capabilities",
  "version": "0.4.0",
  "requires": [
    "capabilities/scoped_workers",
    "capabilities/knowledge_tools",
    "nodes/knowledge_worker",
    "toolboxes/knowledge_reader"
  ],
  "tools": [
    "kb_ingest",
    "kb_task"
  ],
  "toolDefinitions": "tools.json",
  "python": {
    "path": "python",
    "runtime": "datanet.knowledge_agents.runtime"
  },
  "rootNetworks": [
    "knowledge_base"
  ],
  "agentDefaultsByRoot": {
    "knowledge_base": {
      "allowedToolboxes": [
        "knowledge_worker",
        "knowledge_reader",
        "task_documents",
        "agent_messaging"
      ],
      "toolboxes": [],
      "baselineToolboxes": []
    }
  }
}
