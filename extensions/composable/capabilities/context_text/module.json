{
  "format": "nexarbor-module/v3",
  "id": "context.text",
  "version": "1.1.0",
  "name": "上下文文本源",
  "description": "读取本节点的文本，投放类型由组装节点与本节点之间的频道决定。",
  "entry": "module.py:execute",
  "node_types": [
    "text_file"
  ],
  "requires": [],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "order": {
        "type": "number",
        "title": "装配顺序",
        "default": 0
      },
      "when": {
        "type": "object",
        "title": "匹配条件",
        "default": {}
      },
      "event_id": {
        "type": "string",
        "title": "inputs 一次性事件编号",
        "default": ""
      },
      "delivery": {
        "type": "string",
        "title": "投递方式",
        "enum": [
          "followup",
          "steer"
        ],
        "default": "followup"
      },
      "enabled": {
        "type": "boolean",
        "title": "启用",
        "default": true
      },
      "channels": {
        "type": "array",
        "title": "文本读取频道",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true,
        "default": [
          "context.assembler.system_prompt",
          "context.assembler.context",
          "context.assembler.inputs",
          "context.assembler.tail",
          "system_prompt",
          "context",
          "inputs",
          "tail"
        ]
      },
      "channel_modes": {
        "type": "object",
        "additionalProperties": {
          "enum": [
            "allow",
            "deny"
          ]
        }
      }
    },
    "required": []
  },
  "state_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "operations": [
    {
      "name": "read",
      "channels": {
        "config": "channels"
      },
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "type": "object"
      }
    }
  ],
  "signals": [],
  "agent_tools": []
}
