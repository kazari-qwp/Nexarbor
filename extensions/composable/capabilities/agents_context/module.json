{
  "format": "nexarbor-module/v3",
  "id": "agents.context",
  "name": "角色上下文与私人记忆",
  "description": "装配角色身份与情境知识；按需查询当前处境、公开地点和道路图片，私人记忆仅按请求检索。",
  "version": "0.3.0",
  "entry": "module.py:execute",
  "node_types": [
    "agent"
  ],
  "requires": [
    "records.store",
    "place.info"
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "persona": {
        "type": "string",
        "default": "",
        "title": "角色人格",
        "description": "角色长期稳定的身份、性格与说话方式，会写入系统提示词。"
      },
      "common": {
        "type": "string",
        "default": "",
        "title": "通用设定",
        "description": "适用于该角色的世界规则、行为约束或共同背景，会与人格一起写入系统提示词。"
      },
      "map": {
        "type": "string",
        "default": "",
        "title": "旧版地图文字（已停用）",
        "description": "旧版地图文字，仅保留配置兼容。地图改由查询地图工具按实际道路绘制，不再自动注入。"
      },
      "opening": {
        "type": "string",
        "default": "",
        "title": "开场提示",
        "description": "非空时只作为一次性输入投递给角色一次，不会反复写入永久人格。"
      },
      "clock": {
        "type": [
          "string",
          "null"
        ],
        "format": "node-id",
        "default": null,
        "title": "时钟节点",
        "description": "可选。填写已装配时钟与计数组件的节点，准备上下文时读取当前天数与时刻。"
      },
      "max_memories": {
        "type": "integer",
        "minimum": 1,
        "default": 100,
        "title": "最多记忆条数",
        "description": "私人记忆的保留上限，超出后丢弃最早的记忆。"
      },
      "public_fields": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true,
        "default": [
          "name",
          "gender",
          "profession",
          "age_group"
        ],
        "title": "公开资料字段",
        "description": "只把这些自己记录中的字段发布到本模块命名空间供同地其他角色查看；默认公开姓名、性别、职业和年龄段。"
      },
      "knowledge": {
        "type": "array",
        "default": [],
        "title": "情境知识",
        "description": "按自己记录字段匹配后加入模型上下文的稳定知识条目；记录变化后下次准备会自动更新。",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "title": "知识标识",
              "description": "本配置内稳定且唯一的标识，用于生成区别于地图的上下文条目 id。"
            },
            "when": {
              "type": "object",
              "additionalProperties": true,
              "default": {},
              "title": "匹配条件",
              "description": "普通字段等值条件；只有全部字段都与自己记录中的值一致时才提供这段知识。"
            },
            "text": {
              "type": "string",
              "title": "知识文本",
              "description": "条件匹配时放入模型上下文的原生文档内容。"
            }
          },
          "required": [
            "id",
            "when",
            "text"
          ]
        }
      },
      "map_title": {
        "type": "string",
        "default": "地点道路图",
        "maxLength": 80,
        "title": "地图标题"
      },
      "map_layout": {
        "type": "array",
        "default": [],
        "title": "地图布局",
        "description": "可选的稳定示意坐标，0到1；未设置时自动布局。地点编号随网络拷贝重映射。",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "node": {
              "type": [
                "string",
                "null"
              ],
              "format": "node-id"
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "node",
            "x",
            "y"
          ]
        }
      }
    }
  },
  "state_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "memories": {
        "type": "array",
        "maxItems": 10000,
        "title": "私人记忆",
        "description": "仅属于本角色的有限记忆列表。",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 4000,
              "title": "记忆内容"
            },
            "key": {
              "type": "string",
              "title": "记忆键"
            }
          },
          "required": [
            "text"
          ]
        }
      },
      "opening_queued": {
        "type": "boolean",
        "default": false,
        "title": "开场已投递"
      }
    }
  },
  "operations": [
    {
      "name": "prepare",
      "channels": [
        "self"
      ],
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "system_prompt": {
            "type": "string"
          },
          "context": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "text"
              ]
            }
          },
          "tail": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "nearby": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "clock": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "tick": {
                "type": "integer"
              },
              "day": {
                "type": "integer"
              },
              "slot": {
                "type": "string"
              }
            }
          },
          "records": {
            "type": "object"
          },
          "memories": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "opening_queued": {
            "type": "boolean"
          }
        },
        "required": [
          "system_prompt",
          "context",
          "tail",
          "location",
          "nearby",
          "clock",
          "records",
          "memories",
          "opening_queued"
        ]
      }
    },
    {
      "name": "look",
      "channels": [
        "self"
      ],
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "clock": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "tick": {
                "type": "integer"
              },
              "day": {
                "type": "integer"
              },
              "slot": {
                "type": "string"
              }
            },
            "required": [
              "tick",
              "day",
              "slot"
            ],
            "additionalProperties": false
          },
          "location": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "name"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "records": {
            "type": "object"
          },
          "people": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "profile": {
                  "type": "object"
                }
              },
              "required": [
                "id",
                "name",
                "profile"
              ]
            }
          },
          "exits": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name"
              ]
            }
          }
        },
        "required": [
          "clock",
          "location",
          "records",
          "people",
          "exits"
        ]
      }
    },
    {
      "name": "remember",
      "channels": [
        "self"
      ],
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "title": "记忆内容",
            "description": "要记住的内容，不能为空，最多 4000 个字符。"
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "title": "记忆键",
            "description": "可选。相同键可用于幂等重试，不同内容不能复用同一个键。"
          }
        },
        "required": [
          "text"
        ]
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "duplicate": {
            "type": "boolean"
          },
          "memories": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "count": {
            "type": "integer"
          }
        },
        "required": [
          "duplicate",
          "memories",
          "count"
        ]
      }
    },
    {
      "name": "recall",
      "channels": [
        "self"
      ],
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "default": "",
            "title": "查询词",
            "description": "按子串匹配自己的记忆，留空返回全部记忆。"
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string"
          },
          "memories": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "count": {
            "type": "integer"
          }
        },
        "required": [
          "query",
          "memories",
          "count"
        ]
      }
    },
    {
      "name": "place",
      "channels": [
        "self"
      ],
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "place": {
            "type": "string",
            "description": "地点名称或编号；省略时查询当前位置。"
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "exits": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "exits"
        ]
      }
    },
    {
      "name": "map",
      "channels": [
        "self"
      ],
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "format": {
            "const": "nexarbor-tool-content/v1"
          },
          "content": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "format",
          "content"
        ]
      }
    }
  ],
  "signals": [],
  "agent_tools": [
    {
      "id": "remember",
      "name": "记住",
      "description": "把一段个人经历或知识写入自己的私人记忆。",
      "operation": "remember"
    },
    {
      "id": "recall",
      "name": "回忆",
      "description": "按关键词子串检索自己的私人记忆。",
      "operation": "recall"
    },
    {
      "id": "look",
      "name": "查看处境",
      "description": "查看当前时间、个人记录、当前位置、同地人物和可直接前往的地点。不会返回人格、地图或私人记忆。",
      "operation": "look"
    },
    {
      "id": "place",
      "name": "查询地点",
      "description": "按地点名称或编号查询公开用途和相邻道路；省略时查询当前地点。",
      "operation": "place"
    },
    {
      "id": "map",
      "name": "查询地图",
      "description": "取得授权范围内的地点道路图片；图中线段表示道路，箭头表示单向。",
      "operation": "map"
    }
  ]
}
