{
  "format": "nexarbor-module/v3",
  "id": "agents.context",
  "name": "角色上下文与私人记忆",
  "description": "装配角色人格、地图、情境知识与公开资料，刷新位置邻域和时钟，并维护仅本人可读写的私人记忆。",
  "version": "0.2.0",
  "entry": "module.py:execute",
  "node_types": [
    "agent"
  ],
  "requires": [
    "records.store",
    "place.info"
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "persona": {
        "type": "string",
        "default": "",
        "title": "角色人格",
        "description": "角色长期稳定的身份、性格与说话方式，会写入系统提示词。"
      },
      "common": {
        "type": "string",
        "default": "",
        "title": "通用设定",
        "description": "适用于该角色的世界规则、行为约束或共同背景，会与人格一起写入系统提示词。"
      },
      "map": {
        "type": "string",
        "default": "",
        "title": "地图上下文",
        "description": "非空时作为固定地图文本放入模型上下文，适合村落地图或工作组共享说明。"
      },
      "opening": {
        "type": "string",
        "default": "",
        "title": "开场提示",
        "description": "非空时只作为一次性输入投递给角色一次，不会反复写入永久人格。"
      },
      "clock": {
        "type": ["string", "null"],
        "format": "node-id",
        "default": null,
        "title": "时钟节点",
        "description": "可选。填写已装配时钟与计数组件的节点，准备上下文时读取当前天数与时刻。"
      },
      "max_memories": {
        "type": "integer",
        "minimum": 1,
        "default": 100,
        "title": "最多记忆条数",
        "description": "私人记忆的保留上限，超出后丢弃最早的记忆。"
      },
      "public_fields": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true,
        "default": ["name", "gender", "profession", "age_group"],
        "title": "公开资料字段",
        "description": "只把这些自己记录中的字段发布到本模块命名空间供同地其他角色查看；默认公开姓名、性别、职业和年龄段。"
      },
      "knowledge": {
        "type": "array",
        "default": [],
        "title": "情境知识",
        "description": "按自己记录字段匹配后加入模型上下文的稳定知识条目；记录变化后下次准备会自动更新。",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "title": "知识标识",
              "description": "本配置内稳定且唯一的标识，用于生成区别于地图的上下文条目 id。"
            },
            "when": {
              "type": "object",
              "additionalProperties": true,
              "default": {},
              "title": "匹配条件",
              "description": "普通字段等值条件；只有全部字段都与自己记录中的值一致时才提供这段知识。"
            },
            "text": {
              "type": "string",
              "title": "知识文本",
              "description": "条件匹配时放入模型上下文的原生文档内容。"
            }
          },
          "required": ["id", "when", "text"]
        }
      }
    }
  },
  "state_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "memories": {
        "type": "array",
        "maxItems": 10000,
        "title": "私人记忆",
        "description": "仅属于本角色的有限记忆列表。",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 4000,
              "title": "记忆内容"
            },
            "key": {
              "type": "string",
              "title": "记忆键"
            }
          },
          "required": ["text"]
        }
      },
      "opening_queued": {
        "type": "boolean",
        "default": false,
        "title": "开场已投递"
      }
    }
  },
  "operations": [
    {
      "name": "prepare",
      "channels": ["self"],
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "system_prompt": {"type": "string"},
          "context": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string"},
                "text": {"type": "string"}
              },
              "required": ["id", "text"]
            }
          },
          "tail": {"type": "array", "items": {"type": "string"}},
          "location": {"type": ["string", "null"]},
          "nearby": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string"},
                "name": {"type": "string"},
                "path": {"type": "array", "items": {"type": "string"}},
                "strength": {"type": "number"},
                "profile": {"type": "object", "additionalProperties": true}
              },
              "required": ["id", "name", "path", "strength", "profile"]
            }
          },
          "clock": {
            "type": ["object", "null"],
            "properties": {
              "tick": {"type": "integer"},
              "day": {"type": "integer"},
              "slot": {"type": "string"}
            }
          },
          "records": {"type": "object"},
          "memories": {"type": "array", "items": {"type": "object"}},
          "opening_queued": {"type": "boolean"}
        },
        "required": [
          "system_prompt",
          "context",
          "tail",
          "location",
          "nearby",
          "clock",
          "records",
          "memories",
          "opening_queued"
        ]
      }
    },
    {
      "name": "look",
      "channels": ["self"],
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "system_prompt": {"type": "string"},
          "context": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string"},
                "text": {"type": "string"}
              },
              "required": ["id", "text"]
            }
          },
          "tail": {"type": "array", "items": {"type": "string"}},
          "location": {"type": ["string", "null"]},
          "nearby": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string"},
                "name": {"type": "string"},
                "path": {"type": "array", "items": {"type": "string"}},
                "strength": {"type": "number"},
                "profile": {"type": "object", "additionalProperties": true}
              },
              "required": ["id", "name", "path", "strength", "profile"]
            }
          },
          "clock": {
            "type": ["object", "null"],
            "properties": {
              "tick": {"type": "integer"},
              "day": {"type": "integer"},
              "slot": {"type": "string"}
            }
          },
          "records": {"type": "object"},
          "memories": {"type": "array", "items": {"type": "object"}},
          "opening_queued": {"type": "boolean"}
        },
        "required": [
          "system_prompt",
          "context",
          "tail",
          "location",
          "nearby",
          "clock",
          "records",
          "memories",
          "opening_queued"
        ]
      }
    },
    {
      "name": "remember",
      "channels": ["self"],
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "title": "记忆内容",
            "description": "要记住的内容，不能为空，最多 4000 个字符。"
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "title": "记忆键",
            "description": "可选。相同键可用于幂等重试，不同内容不能复用同一个键。"
          }
        },
        "required": ["text"]
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "duplicate": {"type": "boolean"},
          "memories": {"type": "array", "items": {"type": "object"}},
          "count": {"type": "integer"}
        },
        "required": ["duplicate", "memories", "count"]
      }
    },
    {
      "name": "recall",
      "channels": ["self"],
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "default": "",
            "title": "查询词",
            "description": "按子串匹配自己的记忆，留空返回全部记忆。"
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {"type": "string"},
          "memories": {"type": "array", "items": {"type": "object"}},
          "count": {"type": "integer"}
        },
        "required": ["query", "memories", "count"]
      }
    }
  ],
  "signals": [],
  "agent_tools": [
    {
      "id": "remember",
      "name": "记住",
      "description": "把一段个人经历或知识写入自己的私人记忆。",
      "operation": "remember"
    },
    {
      "id": "recall",
      "name": "回忆",
      "description": "按关键词子串检索自己的私人记忆。",
      "operation": "recall"
    },
    {
      "id": "look",
      "name": "查看处境",
      "description": "查看自己的当前账户、位置、附近可达地点与时间。",
      "operation": "look"
    }
  ]
}
