{
  "format": "nexarbor-module/v3",
  "id": "service.actions",
  "name": "可配置业务服务",
  "version": "0.1.0",
  "description": "用同一份组件按配置提供采集、买卖、修理、休息和饮料等业务；库存、钱财和行动点分别保存在场所与请求者 Agent 的记录仓中，支持成本、住所限制、随机事件和幂等重试。",
  "entry": "module.py:execute",
  "node_types": [
    "node"
  ],
  "requires": [
    "records.store"
  ],
  "config_schema": {
    "type": "object",
    "title": "可配置业务服务",
    "properties": {
      "address": {
        "type": [
          "string",
          "null"
        ],
        "title": "业务所在地址",
        "description": "可选。填写后请求者必须位于该地点，核验请求者 place.info.read 返回的 location。",
        "format": "node-id",
        "default": null
      },
      "actions": {
        "type": "array",
        "title": "业务动作",
        "description": "同一模块可通过数组配置多种动作，数量按 quantity 倍数结算。",
        "default": [],
        "items": {
          "type": "object",
          "title": "业务动作",
          "properties": {
            "id": {
              "type": "string",
              "title": "动作标识",
              "description": "请求时使用的稳定标识，例如 gather、buy、rest。",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "title": "动作名称",
              "description": "展示给 Agent 的中文名称。",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "title": "动作说明",
              "description": "说明该动作的行为和用途。",
              "default": ""
            },
            "actor_deltas": {
              "type": "object",
              "title": "请求者增减",
              "description": "请求者记录仓中按数量倍数变化的字段，例如金币、物品、体力。",
              "additionalProperties": {
                "type": "number"
              },
              "default": {}
            },
            "local_deltas": {
              "type": "object",
              "title": "场所库存增减",
              "description": "本服务节点记录仓中按数量倍数变化的字段，例如库存、金币。",
              "additionalProperties": {
                "type": "number"
              },
              "default": {}
            },
            "cost": {
              "type": "integer",
              "title": "行动点消耗",
              "description": "每次成功执行从请求者记录的 ap 字段扣除的行动点。",
              "minimum": 0,
              "default": 1
            },
            "per_unit_cost": {
              "type": "boolean",
              "title": "按数量累计消耗",
              "description": "为真时行动点消耗为 cost × quantity，否则每次只扣 cost。",
              "default": false
            },
            "required_home": {
              "type": [
                "string",
                "null"
              ],
              "title": "必需住所",
              "description": "可选。填写后请求者记录的 home 字段必须与之相等。",
              "format": "node-id",
              "default": null
            }
          },
          "required": [
            "id",
            "title"
          ],
          "additionalProperties": false
        }
      },
      "events": {
        "type": "array",
        "title": "成功事件",
        "description": "动作成功时逐个独立抽取；limit 是全服务共享的成功次数上限，失败不消耗次数。",
        "default": [],
        "items": {
          "type": "object",
          "title": "成功事件",
          "properties": {
            "id": {
              "type": "string",
              "title": "事件标识",
              "description": "用于累计该事件已触发的次数。",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "title": "事件文本",
              "description": "触发时加入 observation 的中文描述。",
              "minLength": 1
            },
            "probability": {
              "type": "number",
              "title": "触发概率",
              "description": "0 到 1 之间，独立性抽取。",
              "minimum": 0,
              "maximum": 1,
              "default": 0
            },
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "title": "共享成功上限",
              "description": "可选正整数；为空表示不限次数，达到上限后不再触发。",
              "minimum": 1,
              "default": null
            },
            "rewards": {
              "type": "object",
              "title": "事件奖励",
              "description": "触发后额外发给成功请求者的数字增减，可与动作增减叠加。",
              "additionalProperties": {
                "type": "number"
              },
              "default": {}
            }
          },
          "required": [
            "id",
            "text"
          ],
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "state_schema": {
    "type": "object",
    "title": "业务服务状态",
    "properties": {
      "event_counts": {
        "type": "object",
        "title": "事件成功计数",
        "description": "按事件标识累计已触发的次数。",
        "additionalProperties": {
          "type": "integer",
          "minimum": 0
        }
      },
      "receipts": {
        "type": "array",
        "title": "幂等回执",
        "description": "最近 200 条带 key 的成功回执，用于重试时返回旧结果。",
        "maxItems": 200,
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "fingerprint": {
              "type": "string"
            },
            "result": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer"
                },
                "actor": {
                  "type": "string"
                },
                "values": {
                  "type": "object",
                  "additionalProperties": true
                },
                "observation": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "duplicate": {
                  "type": "boolean"
                }
              },
              "required": [
                "action",
                "quantity",
                "actor",
                "values",
                "observation",
                "duplicate"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "key",
            "fingerprint",
            "result"
          ],
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "operations": [
    {
      "name": "inspect",
      "channels": [
        "service"
      ],
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "actions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "inventory": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "actions",
          "inventory"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "perform",
      "channels": [
        "service"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "title": "动作标识",
            "description": "要执行的配置动作 id。",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "title": "数量",
            "description": "1 到 100 的整数，默认 1。",
            "minimum": 1,
            "maximum": 100,
            "default": 1
          },
          "key": {
            "type": "string",
            "title": "幂等键",
            "description": "可选非空字符串；相同键和相同动作数量重试时返回旧结果，不重复扣费。",
            "minLength": 1
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "actor": {
            "type": "string"
          },
          "values": {
            "type": "object",
            "additionalProperties": true
          },
          "observation": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duplicate": {
            "type": "boolean"
          }
        },
        "required": [
          "action",
          "quantity",
          "actor",
          "values",
          "observation",
          "duplicate"
        ],
        "additionalProperties": false
      }
    }
  ],
  "signals": [],
  "agent_tools": [
    {
      "id": "inspect",
      "name": "查看服务",
      "description": "查看本业务场所可执行的动作和当前场所库存。",
      "operation": "inspect"
    },
    {
      "id": "perform",
      "name": "执行业务",
      "description": "执行一个配置动作，按数量结算库存、钱财、行动点，并可能触发随机事件。",
      "operation": "perform"
    }
  ]
}
