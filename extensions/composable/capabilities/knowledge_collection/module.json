{
  "format": "nexarbor-module/v3",
  "id": "knowledge.collection",
  "name": "知识集合",
  "version": "0.1.0",
  "description": "以节点本地状态保存可检索、可版本恢复的知识归档。检索为标题与正文的关键词子串匹配，不包含语义嵌入能力。",
  "entry": "module.py:execute",
  "node_types": [
    "node"
  ],
  "requires": [],
  "config_schema": {
    "type": "object",
    "title": "知识集合配置",
    "properties": {
      "title": {
        "type": "string",
        "title": "集合名称",
        "description": "用于界面展示的知识集合名称。",
        "default": "知识集合"
      },
      "read_only": {
        "type": "boolean",
        "title": "只读模式",
        "description": "开启后拒绝新增、删除与恢复，仅允许读取和检索。",
        "default": false
      },
      "max_entries": {
        "type": "integer",
        "title": "最大文档数",
        "description": "允许同时存在的未删除文档数量。",
        "default": 1000,
        "minimum": 1
      },
      "history_limit": {
        "type": "integer",
        "title": "每个文档保留的修订数",
        "description": "超出的旧修订会被清理，仅保留最近的修订摘要与内容。",
        "default": 20,
        "minimum": 1
      }
    },
    "additionalProperties": false
  },
  "state_schema": {
    "type": "object",
    "title": "知识集合状态",
    "properties": {
      "documents": {
        "type": "object",
        "title": "文档表",
        "additionalProperties": {
          "type": "object",
          "required": ["id", "title", "text", "tags", "key", "revision", "deleted", "history"],
          "properties": {
            "id": {"type": "string", "title": "文档标识"},
            "title": {"type": "string", "title": "标题"},
            "text": {"type": "string", "title": "正文"},
            "tags": {"type": "array", "title": "标签", "items": {"type": "string"}},
            "key": {"type": ["string", "null"], "title": "幂等键"},
            "revision": {"type": "integer", "title": "当前修订号", "minimum": 1},
            "deleted": {"type": "boolean", "title": "是否已软删除"},
            "history": {
              "type": "array",
              "title": "历史修订",
              "items": {
                "type": "object",
                "required": ["revision", "title", "text", "tags", "deleted"],
                "properties": {
                  "revision": {"type": "integer", "title": "修订号", "minimum": 1},
                  "title": {"type": "string", "title": "修订标题"},
                  "text": {"type": "string", "title": "修订正文"},
                  "tags": {"type": "array", "title": "修订标签", "items": {"type": "string"}},
                  "deleted": {"type": "boolean", "title": "修订删除状态"}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "idempotency": {
        "type": "object",
        "title": "幂等记录",
        "additionalProperties": {
          "type": "object",
          "required": ["requester", "key", "id", "fingerprint"],
          "properties": {
            "requester": {"type": "string", "title": "请求者"},
            "key": {"type": "string", "title": "幂等键"},
            "id": {"type": "string", "title": "文档标识"},
            "fingerprint": {"type": "string", "title": "内容指纹"}
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "operations": [
    {
      "name": "put",
      "channels": ["knowledge"],
      "parameters": {
        "type": "object",
        "title": "新增或更新文档",
        "required": ["id", "title", "text", "tags"],
        "properties": {
          "id": {"type": "string", "title": "文档标识", "minLength": 1},
          "title": {"type": "string", "title": "标题"},
          "text": {"type": "string", "title": "正文"},
          "tags": {"type": "array", "title": "标签", "items": {"type": "string"}},
          "key": {"type": "string", "title": "幂等键", "description": "同一请求者重复提交相同 key 与内容时返回原文档；内容不同则拒绝。"},
          "expected_revision": {"type": "integer", "title": "期望的当前 revision", "description": "可选。带上 get 读到的当前 revision 做乐观并发校验；文档不存在时当前 revision 为 0，不匹配则返回版本冲突且不修改任何数据。", "minimum": 0}
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": ["id", "revision", "deleted", "created", "idempotent"],
        "properties": {
          "id": {"type": "string"},
          "revision": {"type": "integer", "minimum": 1},
          "deleted": {"type": "boolean"},
          "created": {"type": "boolean"},
          "idempotent": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get",
      "channels": ["knowledge"],
      "parameters": {
        "type": "object",
        "title": "读取文档",
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "title": "文档标识", "minLength": 1}
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": ["document"],
        "properties": {
          "document": {
            "type": "object",
            "required": ["id", "title", "text", "tags", "key", "revision", "deleted"],
            "properties": {
              "id": {"type": "string"},
              "title": {"type": "string"},
              "text": {"type": "string"},
              "tags": {"type": "array", "items": {"type": "string"}},
              "key": {"type": ["string", "null"]},
              "revision": {"type": "integer", "minimum": 1},
              "deleted": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "search",
      "channels": ["knowledge"],
      "parameters": {
        "type": "object",
        "title": "关键词检索",
        "properties": {
          "query": {"type": "string", "title": "关键词", "description": "对标题和正文做不区分大小写的子串匹配；为空时返回所有未删除文档。", "default": ""},
          "tags": {"type": "array", "title": "必需标签", "description": "文档必须包含全部指定标签。", "items": {"type": "string"}, "default": []},
          "limit": {"type": "integer", "title": "返回条数", "minimum": 1, "maximum": 50, "default": 10}
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": ["query", "tags", "items", "total"],
        "properties": {
          "query": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "revision", "tags", "excerpt"],
              "properties": {
                "id": {"type": "string"},
                "title": {"type": "string"},
                "revision": {"type": "integer", "minimum": 1},
                "tags": {"type": "array", "items": {"type": "string"}},
                "excerpt": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "total": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    {
      "name": "remove",
      "channels": ["knowledge"],
      "parameters": {
        "type": "object",
        "title": "软删除文档",
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "title": "文档标识", "minLength": 1},
          "expected_revision": {"type": "integer", "title": "期望的当前 revision", "description": "可选。带上 get 读到的当前 revision 做乐观并发校验；文档不存在时当前 revision 为 0，不匹配则返回版本冲突且不修改任何数据。", "minimum": 0}
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": ["id", "revision", "deleted"],
        "properties": {
          "id": {"type": "string"},
          "revision": {"type": "integer", "minimum": 1},
          "deleted": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    {
      "name": "history",
      "channels": ["knowledge"],
      "parameters": {
        "type": "object",
        "title": "查看修订摘要",
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "title": "文档标识", "minLength": 1}
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": ["id", "items", "total"],
        "properties": {
          "id": {"type": "string"},
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["revision", "title", "deleted"],
              "properties": {
                "revision": {"type": "integer", "minimum": 1},
                "title": {"type": "string"},
                "deleted": {"type": "boolean"}
              },
              "additionalProperties": false
            }
          },
          "total": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    {
      "name": "restore",
      "channels": ["knowledge"],
      "parameters": {
        "type": "object",
        "title": "恢复历史修订",
        "required": ["id", "revision"],
        "properties": {
          "id": {"type": "string", "title": "文档标识", "minLength": 1},
          "revision": {"type": "integer", "title": "历史修订号", "minimum": 1},
          "expected_revision": {"type": "integer", "title": "期望的当前 revision", "description": "可选。带上 get 读到的当前 revision 做乐观并发校验；文档不存在时当前 revision 为 0，不匹配则返回版本冲突且不修改任何数据。", "minimum": 0}
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": ["id", "revision", "restored_from", "deleted"],
        "properties": {
          "id": {"type": "string"},
          "revision": {"type": "integer", "minimum": 1},
          "restored_from": {"type": "integer", "minimum": 1},
          "deleted": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  ],
  "signals": [],
  "agent_tools": [
    {
      "id": "knowledge_put",
      "name": "写入知识",
      "description": "新增或更新一条知识文档并产生新修订；协作写入前先用 knowledge_get 读取当前 revision，再把它作为 expected_revision 传入以避免覆盖他人修改；文档不存在时期望值为 0。也可用 key 防止同一请求者重复写入。",
      "operation": "put"
    },
    {
      "id": "knowledge_get",
      "name": "读取知识",
      "description": "按文档标识读取当前知识内容，包括已软删除文档的状态。",
      "operation": "get"
    },
    {
      "id": "knowledge_search",
      "name": "检索知识",
      "description": "按标题和正文的关键词子串及全部标签过滤未删除文档；这是关键词检索，不是语义或向量检索。",
      "operation": "search"
    },
    {
      "id": "knowledge_remove",
      "name": "删除知识",
      "description": "软删除知识文档，保留历史修订；先 knowledge_get 读取当前 revision 并作为 expected_revision 传入可防止误删他人刚改过的内容；只读模式下拒绝。",
      "operation": "remove"
    },
    {
      "id": "knowledge_history",
      "name": "查看知识历史",
      "description": "查看文档保留的有限修订摘要，仅返回修订号、标题和删除状态。",
      "operation": "history"
    },
    {
      "id": "knowledge_restore",
      "name": "恢复知识修订",
      "description": "从保留的历史修订创建新的当前修订，原历史内容不被改写；先 knowledge_get 读取当前 revision 并作为 expected_revision 传入可避免覆盖并发修改；只读模式下拒绝。",
      "operation": "restore"
    }
  ]
}
