                    "operation",
                    "channels"
                  ]
                },
                "default": []
              },
              "document_roots": {
                "type": "array",
                "title": "额外允许读取的文本目录",
                "description": "默认只允许项目目录。额外目录属于明确的文件读取授权。",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            },
            "required": []
          }
        },
        "required": []
      },
      "result": {
        "type": "object"
      }
    }
  ],
  "signals": [],
  "agent_tools": [],
  "frontend": {
    "entry": "ui.html",
    "title": "上下文来源与装配预览",
    "height": 700,
    "preview_operation": "preview"
  }
}
