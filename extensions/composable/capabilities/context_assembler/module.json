                    },
                    "event_id": {
                      "type": "string",
                      "title": "一次性事件编号",
                      "default": ""
                    },
                    "delivery": {
                      "type": "string",
                      "title": "事件投递方式",
                      "enum": [
                        "followup",
                        "steer"
                      ],
                      "default": "followup"
                    },
                    "enabled": {
                      "type": "boolean",
                      "title": "启用",
                      "default": true
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "type"
                  ]
                },
                "default": []
              },
              "bindings": {
                "type": "array",
                "title": "条件事实来源（显式只读调用）",
