{
  "experience_query": {
    "name": "experience_query",
    "description": "查询经验线索，默认包括已验证和待审核；status可筛选。待审核不代表建议可靠，不自动加载；不授予权限。",
    "parameters": {
      "type": "object",
      "properties": {
        "include_resident": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "all",
            "verified",
            "pending"
          ]
        },
        "query": {
          "type": "string"
        },
        "entry_id": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "enum": [
            "common",
            "tool",
            "toolbox",
            "role",
            "node"
          ]
        },
        "id": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "experience_submit": {
    "name": "experience_submit",
    "description": "提交已解决并验证的问题为候选经验；不会自动发布。未解决阻塞使用 datanet_feedback。",
    "parameters": {
      "type": "object",
      "properties": {
        "applies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "common",
                  "tool",
                  "toolbox",
                  "role",
                  "node"
                ]
              },
              "id": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          }
        },
        "trigger": {
          "type": "string"
        },
        "advice": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "applies",
        "trigger",
        "advice",
        "evidence",
        "version"
      ],
      "additionalProperties": false
    }
  },
  "experience_review": {
    "name": "experience_review",
    "description": "仅获授权维护者使用：查看候选、审核发布、合并重复、停用过期经验或set_core调整常加载。推广候选仍须维护者确认；发布前核实证据和版本。",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "list",
            "publish",
            "reject",
            "merge",
            "retire",
            "set_core"
          ]
        },
        "core": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "merge_into": {
          "type": "string"
        },
        "changes": {
          "type": "object"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "verified",
            "retired",
            "rejected",
            "merged"
          ]
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    }
  }
}
