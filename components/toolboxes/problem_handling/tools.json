{
  "handle_problem": {
    "name": "handle_problem",
    "description": "遇到影响任务继续的问题，从这里开始处理；按需加载经验查询、获准排障流程和工具。进入不代表上报，也不增加任何业务权限。简单的参数或格式错误，不要进入此通道。",
    "parameters": {
      "type": "object",
      "properties": {
        "problem": {
          "type": "string",
          "maxLength": 240,
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "enum": [
            "self",
            "subordinate",
            "dependency"
          ],
          "description": "问题归属，不决定是否阻塞当前委托"
        },
        "origin_node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "下属问题必填实际节点ID；外部依赖可省略"
        },
        "problem_id": {
          "type": "string",
          "description": "重新处理已结束或中断的问题时复用原ID，保留累计尝试"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "默认3，按上级约束可降低；重开只能保持或降低，不能增加"
        }
      },
      "required": [
        "problem",
        "origin"
      ],
      "additionalProperties": false
    }
  },
  "problem_attempt": {
    "name": "problem_attempt",
    "description": "查过经验后开始验证方案。有experience_id代表尝试查询到的经验；不填则自行修复，必须拥有self_repair授权。只使用原有业务工具。",
    "parameters": {
      "type": "object",
      "properties": {
        "experience_id": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "problem_resolved": {
    "name": "problem_resolved",
    "description": "问题已解决且完成实际工具验证后结束排障。填简短依据；自行修复须先提交候选经验。记录成功复用并撤下临时工具，不自动提升常加载。",
    "parameters": {
      "type": "object",
      "properties": {
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "evidence"
      ],
      "additionalProperties": false
    }
  },
  "problem_defer": {
    "name": "problem_defer",
    "description": "结束本次排障但不标记解决。仅当当前委托仍可继续或允许交付失败结果时使用；必须记录原因、未解决影响及继续/交付依据。保留尝试记录与提示，不报错、不结束任务、不计成功经验。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "impact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "continuation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "说明为何未解决仍可履行当前委托，以及下一步如何正常交付"
        }
      },
      "required": [
        "reason",
        "impact",
        "continuation"
      ],
      "additionalProperties": false
    }
  },
  "datanet_feedback": {
    "name": "datanet_feedback",
    "description": "仅当未解决问题确实阻塞自身当前委托时上报并停止。必填task_blocker说明无法继续或交付的原因；下属失败不自动等于自身阻塞。missing_tool/permission_denied使用固定短文本，只有other填写message。可交付失败结果时用problem_defer后正常汇报。",
    "parameters": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "missing_tool",
            "permission_denied",
            "other"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "仅other填写的简短错误，最多80字。"
        },
        "task_blocker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "说明该问题为何阻塞我当前受托任务，而非仅转发下属错误"
        }
      },
      "required": [
        "category",
        "task_blocker"
      ],
      "additionalProperties": false
    }
  },
  "datanet_resolve_feedback": {
    "name": "datanet_resolve_feedback",
    "description": "仅限处理`datanet_feedback`的通道:管理者查看并修复真实报错节点，可补充指令、职责或工具箱。",
    "parameters": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": [
            "inspect",
            "instruct",
            "update_prompt",
            "add_toolboxes"
          ]
        },
        "instruction": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "toolboxes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": []
          },
          "uniqueItems": true
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    }
  },
  "datanet_recovery_status": {
    "name": "datanet_recovery_status",
    "description": "查看已恢复 Agent、网络讨论状态和中断时结果不明的操作；这些操作不会自动重放。",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  }
}
