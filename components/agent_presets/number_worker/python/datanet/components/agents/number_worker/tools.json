[
  {
    "type": "function",
    "function": {
      "name": "read",
      "description": "读取本节点。key 按主键读取，filter 按条件查询，semantic 语义检索；不支持的方法返回 unsupported。",
      "parameters": {
        "type": "object",
        "properties": {
          "request": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "key",
                  "filter",
                  "semantic"
                ]
              },
              "key": {
                "type": "string"
              },
              "filters": {
                "type": "object"
              },
              "query": {
                "type": "string"
              },
              "top_k": {
                "type": "integer"
              }
            },
            "required": [
              "method"
            ],
            "additionalProperties": false,
            "description": "key 方法必须提供 key；filter 方法必须提供 filters；semantic 必须提供 query，可选 top_k。不得混用字段。"
          }
        },
        "required": [
          "request"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_schema",
      "description": "查看本节点的字段、主键及类型结构，不读取记录值。",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  }
]
