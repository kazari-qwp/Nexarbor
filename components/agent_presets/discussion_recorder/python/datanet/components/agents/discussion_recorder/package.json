{
  "kind": "agent",
  "version": 1,
  "id": "discussion_recorder",
  "description": "小组讨论的记录与成果负责人：整理已确认结论、决策依据、进展和未解决问题，维护公共笔记本并编写最终成果；发现遗漏或矛盾时也参与讨论。",
  "config": {
    "model": "deepseek-chat",
    "prompt_path": "../../../../../../recorder/prompt.md",
    "tools_path": "tools.json",
    "max_rounds": 10,
    "max_tokens": 2200,
    "thinking": false,
    "max_signal_strength": 2
  }
}
