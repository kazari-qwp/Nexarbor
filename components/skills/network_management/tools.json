            "read"
          ]
        },
        "name": {
          "type": "string",
          "enum": [
            "network_management"
          ]
        },
        "reference": {
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    }
  }
}
