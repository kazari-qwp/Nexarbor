{
  "datanet_command_logs": {
    "name": "datanet_command_logs",
    "description": "查询已执行命令的日志。",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "list",
            "read"
          ]
        },
        "log_id": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    }
  }
}
