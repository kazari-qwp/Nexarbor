{
  "kind": "network",
  "version": 1,
  "id": "delegated_number",
  "description": "协调者与数字处理者组成的委托拼图。",
  "network": {
    "version": 3,
    "nodes": [
      {
        "type": "node",
        "node_id": "root",
        "name": "委托协调者",
        "data_kind": null,
        "parameters": {},
        "connections": {
          "read_interfaces": [
            {
              "target_node_id": "worker",
              "threshold": 0,
              "visibility": "public",
              "multiplier": 1
            }
          ],
          "write_interfaces": []
        },
        "agent": {
          "package": "../../../../../../../agent_presets/coordinator/python/datanet/components/agents/coordinator"
        },
        "description": "协调任务并委托 worker 处理本地数字。",
        "divergence": -1,
        "toolboxes": [],
        "expose": [],
        "management_parent_id": null
      },
      {
        "type": "value",
        "node_id": "worker",
        "name": "本地数字处理者",
        "data_kind": "number",
        "parameters": {
          "value": 42
        },
        "connections": {
          "read_interfaces": [],
          "write_interfaces": []
        },
        "agent": {
          "package": "../../../../../../../agent_presets/number_worker/python/datanet/components/agents/number_worker"
        },
        "description": "保存模拟数字 42，Agent 负责读取自身数据并回复委托。",
        "divergence": -1,
        "toolboxes": [
          "local_data"
        ],
        "expose": [
          "read",
          "get_schema",
          "write"
        ],
        "management_parent_id": "root"
      }
    ],
    "delegations": [
      {
        "source": "root",
        "target": "worker"
      }
    ]
  },
  "entry_points": {
    "root": "root",
    "worker": "worker"
  },
  "toolkits": {}
}
