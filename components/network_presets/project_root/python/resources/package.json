{
  "kind": "network",
  "version": 1,
  "id": "project_root",
  "description": "用户项目根网络：负责人根节点连接三个私有项目文档，按任务挂载工作子节点和子网络。",
  "network": {
    "version": 3,
    "nodes": [
      {
        "type": "agent",
        "node_id": "root",
        "name": "项目根节点",
        "data_kind": "agent",
        "parameters": {
          "file_path": "root_memory.md"
        },
        "connections": {
          "read_interfaces": [
            {
              "target_node_id": "root/project",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            },
            {
              "target_node_id": "root/progress",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            },
            {
              "target_node_id": "root/work",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            }
          ],
          "write_interfaces": [
            {
              "target_node_id": "root/project",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            },
            {
              "target_node_id": "root/progress",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            },
            {
              "target_node_id": "root/work",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            }
          ]
        },
        "agent": {
          "package": "agent"
        },
        "description": "项目负责人入口，组织工作子节点和子网络，维护项目目标、进度和当前分工。",
        "divergence": -1,
        "toolboxes": [],
        "expose": [],
        "management_parent_id": null
      },
      {
        "type": "text_file",
        "node_id": "root/project",
        "name": "项目目标",
        "data_kind": "markdown",
        "parameters": {
          "file_path": "project.md",
          "delivery": "query"
        },
        "connections": {
          "read_interfaces": [],
          "write_interfaces": []
        },
        "agent": null,
        "description": "项目目标、范围、约束、交付要求与验收标准",
        "divergence": -1,
        "toolboxes": [
          "local_data"
        ],
        "expose": [
          "read",
          "get_schema",
          "write"
        ],
        "management_parent_id": "root"
      },
      {
        "type": "text_file",
        "node_id": "root/progress",
        "name": "项目进度",
        "data_kind": "markdown",
        "parameters": {
          "file_path": "progress.md",
          "delivery": "query"
        },
        "connections": {
          "read_interfaces": [],
          "write_interfaces": []
        },
        "agent": null,
        "description": "阶段进度、重要决策、已完成事项和待解决问题",
        "divergence": -1,
        "toolboxes": [
          "local_data"
        ],
        "expose": [
          "read",
          "get_schema",
          "write"
        ],
        "management_parent_id": "root"
      },
      {
        "type": "text_file",
        "node_id": "root/work",
        "name": "当前工作与分工",
        "data_kind": "markdown",
        "parameters": {
          "file_path": "work.md",
          "delivery": "query"
        },
        "connections": {
          "read_interfaces": [],
          "write_interfaces": []
        },
        "agent": null,
        "description": "当前任务、工作节点、负责人、状态、阻塞和下一步",
        "divergence": -1,
        "toolboxes": [
          "local_data"
        ],
        "expose": [
          "read",
          "get_schema",
          "write"
        ],
        "management_parent_id": "root"
      }
    ],
    "delegations": []
  },
  "entry_points": {
    "root": "root"
  },
  "toolkits": {}
}
