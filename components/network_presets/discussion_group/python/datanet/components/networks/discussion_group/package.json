{
  "kind": "network",
  "version": 1,
  "id": "discussion_group",
  "description": "讨论小组：一个讨论小组，默认只有讨论工具，无终端等其他工具。适合讨论和指定方案。",
  "network": {
    "version": 3,
    "nodes": [
      {
        "type": "discussion_board",
        "node_id": "board",
        "name": "board",
        "data_kind": "text",
        "description": "只通过read_round读取快照，通过submit_round/skip_round提交，由代码归档。",
        "divergence": -1,
        "parameters": {
          "file_path": "data/board.md",
          "members": [
            "leader",
            "recorder",
            "member_1"
          ],
          "leader_id": "leader",
          "recorder_id": "recorder",
          "project_id": "project",
          "notebook_id": "notebook",
          "output_id": "output"
        },
        "connections": {
          "read_interfaces": [
            {
              "target_node_id": "project",
              "threshold": 0,
              "visibility": "public",
              "multiplier": 1
            },
            {
              "target_node_id": "notebook",
              "threshold": 0,
              "visibility": "public",
              "multiplier": 1
            },
            {
              "target_node_id": "output",
              "threshold": 0,
              "visibility": "public",
              "multiplier": 1
            },
            {
              "target_node_id": "leader",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            },
            {
              "target_node_id": "recorder",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            },
            {
              "target_node_id": "member_1",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            }
          ],
          "write_interfaces": []
        },
        "agent": null,
        "toolboxes": [
          "local_data"
        ],
        "expose": [
          "get_schema",
          "load_project"
        ],
        "management_parent_id": null
      },
      {
        "type": "text_file",
        "node_id": "project",
        "name": "project",
        "data_kind": "text",
        "description": "项目目标、进度和当前工作；由外部根节点维护。",
        "divergence": -1,
        "parameters": {
          "file_path": "data/project.md",
          "delivery": "query"
        },
        "connections": {
          "read_interfaces": [],
          "write_interfaces": []
        },
        "agent": null,
        "toolboxes": [
          "local_data"
        ],
        "expose": [
          "read",
          "get_schema",
          "write"
        ],
        "management_parent_id": "board"
      },
      {
        "type": "text_file",
        "node_id": "notebook",
        "name": "公共笔记",
        "data_kind": "text",
        "description": "由recorder维护",
        "divergence": -1,
        "parameters": {
          "file_path": "data/notebook.md",
          "delivery": "resident"
        },
        "connections": {
          "read_interfaces": [],
          "write_interfaces": []
        },
        "agent": null,
        "toolboxes": [
          "local_data"
        ],
        "expose": [
          "get_schema",
          "write"
        ],
        "management_parent_id": "board"
      },
      {
        "type": "text_file",
        "node_id": "output",
        "name": "output",
        "data_kind": "text",
        "description": "最终成果；仅Recorder写入。",
        "divergence": -1,
        "parameters": {
          "file_path": "data/output.md"
        },
        "connections": {
          "read_interfaces": [],
          "write_interfaces": []
        },
        "agent": null,
        "toolboxes": [
          "local_data"
        ],
        "expose": [
          "read",
          "get_schema",
          "write"
        ],
        "management_parent_id": "board"
      },
      {
        "type": "agent",
        "node_id": "leader",
        "name": "leader",
        "data_kind": "agent",
        "description": "讨论成员 leader；读取共享资料，维护私人笔记。",
        "divergence": -1,
        "parameters": {
          "file_path": "data/leader_memory.md"
        },
        "connections": {
          "read_interfaces": [
            {
              "target_node_id": "board",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            },
            {
              "target_node_id": "project",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            },
            {
              "target_node_id": "notebook",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            }
          ],
          "write_interfaces": [
            {
              "target_node_id": "board",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            }
          ]
        },
        "agent": {
          "package": "../../../../../../../agent_presets/discussion_leader/python/datanet/components/agents/discussion_leader"
        },
        "toolboxes": [],
        "expose": [],
        "management_parent_id": "board"
      },
      {
        "type": "agent",
        "node_id": "recorder",
        "name": "recorder",
        "data_kind": "agent",
        "description": "讨论成员 recorder；读取共享资料，维护私人笔记。",
        "divergence": -1,
        "parameters": {
          "file_path": "data/recorder_memory.md"
        },
        "connections": {
          "read_interfaces": [
            {
              "target_node_id": "board",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            },
            {
              "target_node_id": "project",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            },
            {
              "target_node_id": "notebook",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            }
          ],
          "write_interfaces": [
            {
              "target_node_id": "board",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            },
            {
              "target_node_id": "notebook",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            },
            {
              "target_node_id": "output",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            }
          ]
        },
        "agent": {
          "package": "../../../../../../../agent_presets/discussion_recorder/python/datanet/components/agents/discussion_recorder"
        },
        "toolboxes": [],
        "expose": [],
        "management_parent_id": "board"
      },
      {
        "type": "agent",
        "node_id": "member_1",
        "name": "member_1",
        "data_kind": "agent",
        "description": "讨论成员 member_1；读取共享资料，维护私人笔记。",
        "divergence": -1,
        "parameters": {
          "file_path": "data/member_1_memory.md"
        },
        "connections": {
          "read_interfaces": [
            {
              "target_node_id": "board",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            },
            {
              "target_node_id": "project",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            },
            {
              "target_node_id": "notebook",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            }
          ],
          "write_interfaces": [
            {
              "target_node_id": "board",
              "threshold": 0,
              "visibility": "private",
              "multiplier": 1
            }
          ]
        },
        "agent": {
          "package": "../../../../../../../agent_presets/discussion_member/python/datanet/components/agents/discussion_member"
        },
        "toolboxes": [],
        "expose": [],
        "management_parent_id": "board"
      }
    ],
    "delegations": [
      {
        "source": "board",
        "target": "leader"
      },
      {
        "source": "board",
        "target": "recorder"
      },
      {
        "source": "board",
        "target": "member_1"
      }
    ]
  },
  "entry_points": {
    "board": "board",
    "project": "project",
    "output": "output"
  },
  "toolkits": {
    "board": [
      "discussion_group_storage"
    ]
  }
}
