    "agents.memory": {
      "access": {
        "channels": [
          "self"
        ],
        "strength": 0
      },
      "config": {
        "max_memories": 100
      },
      "state": {
        "memories": [
          {
            "key": "day1-morning-plan",
            "text": "第1天早上：从居民楼B出发，经医院走到树林，用掉6点行动值（剩4点，不够砍柴）。路：居民楼B—医院—树林，两段路。伐木一次花6点得3根木材；木材卖给商店每根2金币。从树林去商店要走树林—医院—居民楼B—商店（3段，9点），或树林—矿坑—铁匠铺—商店。计划：中午在树林砍一次柴，得3根；下午回程去商店卖，能得6金币。"
          },
          {
            "key": "forest-chop-action",
            "text": "树林可执行业务：动作 chop（砍柴），消耗6点行动值，需斧头1，得木材3。早上剩4点砍不了，等中午。"
          },
          {
            "key": "day1-afternoon",
            "text": "第1天下午：中午在树林砍柴得3根木材（耗6点），走到医院；下午从医院回居民楼B、再到商店，把3根木材卖了6金币，现共14金币、木材0。之后想走“商店—居民楼B”那条回住处，结果误走进居民楼A（商店也直通居民楼A），行动值用尽。注意：商店邻居民楼B、居民楼A、酒馆；进别人家要登记。下一步计划：傍晚从居民楼A回居民楼B，再往医院走；午夜到医院→树林砍柴；次日早上再扛回来卖。"
          },
          {
            "key": "day1-evening-route",
            "text": "第1天傍晚：人在居民楼A，发现居民楼A只通商店、民政局、酒馆（不直接通居民楼B）。走居民楼A→民政局→医院→树林，三段路9点，到树林时剩1点。现总金币14、木材0、斧头1。午夜计划：在树林砍柴（6点，得3根）；剩4点走回医院。次日早上从医院→居民楼B→商店卖木材（3根6金币）。"
          },
          {
            "key": "day2-morning",
            "text": "第2天早上：从医院→居民楼B→商店，把午夜砍的3根木材卖了6金币，现共20金币、木材0、斧头1。之后想回居民楼B，却误点了居民楼A的移动工具，又落到居民楼A（行动值用尽）。教训：移动工具名里的“来源”才是目的地，别点错。商店不直通居民楼B；从居民楼A去树林只有一条：居民楼A→民政局→医院→树林（9点）。中午计划：走这条到树林；下午砍柴6点再回医院；傍晚医院→居民楼B→商店卖。"
          },
          {
            "key": "day2-evening-shop-broke",
            "text": "第2天傍晚：在树林砍得3根木材，走到医院，再回居民楼B、到商店，结果卖不出去——连卖1根都报“商店资金不足”。看价目表：商店库存木材已15根、矿石10根，钱应该都收光了。现在身上20金币、3根木材没出手，人在居民楼B（行动值剩1）。小路来信说愿意替我背木材去卖，每根抽半金币，我已回信说明柜上没钱、先不劳他。待办：等商店有钱再卖（手里3根，之后还会再攒）。"
          },
          {
            "key": "day2-midnight",
            "text": "第2天午夜：先到商店再试卖木材，仍“商店资金不足”，柜上一直没钱。于是从商店回居民楼B、再到医院落脚（行动值剩1）。身上20金币、3根木材、斧头1。第3天早上计划：医院→树林（3点），砍柴（6点，得3根，累计6根），剩1点。之后去商店看有没有钱，没钱就先把木材扛着。"
          },
          {
            "key": "day3-status",
            "text": "第3天：中午/傍晚两趟都试着卖木材，商店仍“商店资金不足”（连6根都收不了）；铁匠铺没有收木材的门路。到傍晚已砍到9根木材，身上20金币，人在医院（行动值剩1）。第4天早上计划：医院→居民楼B→商店，柜台有钱就全卖（9根18金币），没钱就先试着卖1根、或改去酒馆打听商店什么时候有本钱。"
          },
          {
            "key": "day3-midnight-shop-trickle",
            "text": "第3天午夜：医院→居民楼B→商店。整批卖9根报“资金不足”，单独卖1根却成了（2金币）——说明柜台的钱是一点点攒的，一回大概只够收一根。再卖第二根又没钱。现共22金币、8根木材、斧头1，人在居民楼B（行动值0）。做法：以后每次到商店就先卖1根试试，能卖就继续，不能就等下一时段。"
          },
          {
            "key": "day4-status",
            "text": "第4天：早上/下午/傍晚三次到商店试卖，柜台一直“资金不足”，一根也没卖出去（第3天午夜那次卖出1根是个例外，柜上只攒够2金币）。那天共砍两担，木材已积到14根，金币22，人在医院。第5天早上打算：医院→居民楼B→商店，先试卖1根，卖得动就再卖，卖不动就先去树林接着砍。"
          },
          {
            "key": "day5-noon",
            "text": "第5天：柜台这回攒了6金币，早上连卖3根得6金币（每卖一根要花1点行动值！），共28金币、11根木材。中午再到商店已没钱，于是走到树林（商店→居民楼B→医院→树林，9点）。经验：卖货每次1根、每根1点行动值；柜台的钱是慢慢攒的，一趟最多卖三四根。下午计划：砍柴6点得3根，再走回医院3点。"
          }
        ]
      }
    },
