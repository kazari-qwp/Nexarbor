{
  "format": "nexarbor-module/v3",
  "id": "service.actions",
  "name": "可配置业务服务",
  "version": "0.3.0",
  "description": "用同一份组件按配置提供采集、买卖、借贷、修理、休息和饮料等业务；库存、钱财和行动点分别保存在场所与请求者 Agent 的记录仓中，支持值/物品门槛、最终上限、字段设置、成本、住所限制、随机事件、结算后可选钩子和幂等重试。",
  "entry": "module.py:execute",
  "node_types": [
    "node"
  ],
  "requires": [
    "records.store"
  ],
  "config_schema": {
    "type": "object",
    "title": "可配置业务服务",
    "properties": {
      "address": {
        "type": [
          "string",
          "null"
        ],
        "title": "业务所在地址",
        "description": "可选。填写后请求者必须位于该地点，核验请求者 place.info.read 返回的 location。",
        "format": "node-id",
        "default": null
      },
      "actions": {
        "type": "array",
        "title": "业务动作",
        "description": "同一模块可通过数组配置多种动作，数量按 quantity 倍数结算。",
        "default": [],
        "items": {
          "type": "object",
          "title": "业务动作",
          "properties": {
            "id": {
              "type": "string",
              "title": "动作标识",
              "description": "请求时使用的稳定标识，例如 gather、buy、rest。",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "title": "动作名称",
              "description": "展示给 Agent 的中文名称。",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "title": "动作说明",
              "description": "说明该动作的行为和用途。",
              "default": ""
            },
            "actor_deltas": {
              "type": "object",
              "title": "请求者增减",
              "description": "请求者记录仓中按数量倍数变化的字段，例如金币、物品、体力。",
              "additionalProperties": {
                "type": "number"
              },
              "default": {}
            },
            "local_deltas": {
              "type": "object",
              "title": "场所库存增减",
              "description": "本服务节点记录仓中按数量倍数变化的字段，例如库存、金币。",
              "additionalProperties": {
                "type": "number"
              },
              "default": {}
            },
            "cost": {
              "type": "integer",
              "title": "行动点消耗",
              "description": "每次成功执行从请求者记录的 ap 字段扣除的行动点。",
              "minimum": 0,
              "default": 1
            },
            "per_unit_cost": {
              "type": "boolean",
              "title": "按数量累计消耗",
              "description": "为真时行动点消耗为 cost × quantity，否则每次只扣 cost。",
              "default": false
            },
            "required_home": {
              "type": [
                "string",
                "null"
              ],
              "title": "必需住所",
              "description": "可选。填写后请求者记录的 home 字段必须与之相等。",
              "format": "node-id",
              "default": null
            },
            "require_values": {
              "type": "object",
              "title": "必需记录值",
              "description": "可选。请求者当前记录的每个字段都必须与给定值严格相等，缺失或不一致时拒绝；例如 {\"adult\": true}。",
              "additionalProperties": true,
              "default": {},
              "examples": [
                {
                  "adult": true
                }
              ]
            },
            "require_items": {
              "type": "object",
              "title": "必需物品（按数量倍数）",
              "description": "可选。请求者当前持有量必须至少为“配置值 × quantity”；只校验、不自动消耗，例如 {\"pickaxe\": 1}。",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              },
              "default": {},
              "examples": [
                {
                  "pickaxe": 1
                }
              ]
            },
            "actor_maximums": {
              "type": "object",
              "title": "请求者最终上限",
              "description": "可选。动作增减与全部事件奖励计算完后，请求者这些字段的最终值不得超过上限；例如 {\"debt\": 8}。",
              "additionalProperties": {
                "type": "number"
              },
              "default": {},
              "examples": [
                {
                  "debt": 8
                }
              ]
            },
            "actor_set": {
              "type": "object",
              "title": "请求者字段设置",
              "description": "可选。成功时直接设置请求者字段，可包含任意 JSON；该对象不乘 quantity，写入顺序为先 set 后 deltas；修好工具可设置 {\"pickaxe_state\": \"良好\"}。",
              "additionalProperties": true,
              "default": {},
              "examples": [
                {
                  "pickaxe_state": "良好"
                }
              ]
            }
          },
          "required": [
            "id",
            "title"
          ],
          "additionalProperties": false
        }
      },
      "events": {
        "type": "array",
        "title": "成功事件",
        "description": "动作成功时逐个独立抽取；limit 是全服务共享的成功次数上限，失败不消耗次数。",
        "default": [],
        "items": {
          "type": "object",
          "title": "成功事件",
          "properties": {
            "id": {
              "type": "string",
              "title": "事件标识",
              "description": "用于累计该事件已触发的次数。",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "title": "事件文本",
              "description": "触发时加入 observation 的中文描述。",
              "minLength": 1
            },
            "probability": {
              "type": "number",
              "title": "触发概率",
              "description": "0 到 1 之间，独立性抽取。",
              "minimum": 0,
              "maximum": 1,
              "default": 0
            },
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "title": "共享成功上限",
              "description": "可选正整数；为空表示不限次数，达到上限后不再触发。",
              "minimum": 1,
              "default": null
            },
            "rewards": {
              "type": "object",
              "title": "事件奖励",
              "description": "触发后额外发给成功请求者的数字增减，可与动作增减叠加。",
              "additionalProperties": {
                "type": "number"
              },
              "default": {}
            }
          },
          "required": [
            "id",
            "text"
          ],
          "additionalProperties": false
        }
      },
      "after_hooks": {
        "type": "array",
        "title": "业务成功后钩子",
        "description": "可选。本地与请求者记录写入成功、仍在锁内且保存幂等回执之前，按数组顺序调用匹配的钩子；用于接入地点概率事件等可选能力，组件本身不写死具体模块。",
        "default": [],
        "items": {
          "type": "object",
          "title": "后续钩子",
          "properties": {
            "target": {
              "type": "string",
              "title": "调用目标",
              "description": "local 表示本服务节点，requester 表示真实请求者；两者都在本次锁定集合内。",
              "enum": [
                "local",
                "requester"
              ]
            },
            "module": {
              "type": "string",
              "title": "模块标识",
              "description": "要调用的已装配模块 id，例如 events.chance。",
              "minLength": 1
            },
            "operation": {
              "type": "string",
              "title": "操作名称",
              "description": "要调用的公开操作名称，例如 sample。",
              "minLength": 1
            },
            "arguments": {
              "type": "object",
              "title": "调用参数",
              "description": "传给目标操作的普通对象参数，原样转交；默认空对象。",
              "additionalProperties": true,
              "default": {}
            },
            "actions": {
              "type": "array",
              "title": "匹配动作",
              "description": "只在这些业务动作成功后调用；空数组表示任何动作都匹配。",
              "default": [],
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "target",
            "module",
            "operation"
          ],
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "state_schema": {
    "type": "object",
    "title": "业务服务状态",
    "properties": {
      "event_counts": {
        "type": "object",
        "title": "事件成功计数",
        "description": "按事件标识累计已触发的次数。",
        "additionalProperties": {
          "type": "integer",
          "minimum": 0
        }
      },
      "receipts": {
        "type": "array",
        "title": "幂等回执",
        "description": "最近 200 条带 key 的成功回执，用于重试时返回旧结果。",
        "maxItems": 200,
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "fingerprint": {
              "type": "string"
            },
            "result": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer"
                },
                "actor": {
                  "type": "string"
                },
                "values": {
                  "type": "object",
                  "additionalProperties": true
                },
                "observation": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "duplicate": {
                  "type": "boolean"
                },
                "after_results": {
                  "type": "array",
                  "title": "后续钩子结果",
                  "description": "按调用顺序记录 target/module/operation/data。",
                  "items": {
                    "type": "object",
                    "properties": {
                      "target": {
                        "type": "string"
                      },
                      "module": {
                        "type": "string"
                      },
                      "operation": {
                        "type": "string"
                      },
                      "data": {}
                    },
                    "required": [
                      "target",
                      "module",
                      "operation",
                      "data"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "action",
                "quantity",
                "actor",
                "values",
                "observation",
                "duplicate",
                "after_results"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "key",
            "fingerprint",
            "result"
          ],
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "operations": [
    {
      "name": "inspect",
      "channels": [
        "service",
        "location"
      ],
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "actions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "inventory": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "actions",
          "inventory"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "perform",
      "channels": [
        "service",
        "location"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "title": "动作标识",
            "description": "要执行的配置动作 id。",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "title": "数量",
            "description": "1 到 100 的整数，默认 1。",
            "minimum": 1,
            "maximum": 100,
            "default": 1
          },
          "key": {
            "type": "string",
            "title": "幂等键",
            "description": "可选非空字符串；相同键和相同动作数量重试时返回旧结果，不重复扣费。",
            "minLength": 1
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "actor": {
            "type": "string"
          },
          "values": {
            "type": "object",
            "additionalProperties": true
          },
          "observation": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duplicate": {
            "type": "boolean"
          },
          "after_results": {
            "type": "array",
            "title": "后续钩子结果",
            "description": "按调用顺序记录 target/module/operation/data。",
            "items": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "string"
                },
                "module": {
                  "type": "string"
                },
                "operation": {
                  "type": "string"
                },
                "data": {}
              },
              "required": [
                "target",
                "module",
                "operation",
                "data"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "action",
          "quantity",
          "actor",
          "values",
          "observation",
          "duplicate",
          "after_results"
        ],
        "additionalProperties": false
      }
    }
  ],
  "signals": [],
  "agent_tools": [
    {
      "id": "inspect",
      "name": "查看服务",
      "description": "查看本业务场所可执行的动作和当前场所库存。",
      "operation": "inspect"
    },
    {
      "id": "perform",
      "name": "执行业务",
      "description": "执行一个配置动作，按数量结算库存、钱财、行动点，并可能触发随机事件。",
      "operation": "perform"
    }
  ]
}
