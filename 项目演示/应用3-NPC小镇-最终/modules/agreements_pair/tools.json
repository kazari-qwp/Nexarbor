        },
        "rule": {
          "type": "string",
          "minLength": 1,
          "title": "规则标识",
          "description": "要同意的配置规则 id。"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "title": "幂等键",
          "description": "请求者在当前模块实例内使用的非空幂等键；相同键与相同对象重试不会重复扣费。"
        }
      }
    }
  }
