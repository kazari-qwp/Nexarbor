          "maximum": 100,
          "default": 1
        },
        "key": {
          "type": "string",
          "title": "幂等键",
          "description": "可选非空字符串；相同键和相同动作数量重试时返回旧结果，不重复扣费。",
          "minLength": 1
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    }
  }
