{
  "type": "agent",
  "node_id": "root",
  "name": "根 Agent · 用户入口",
  "description": "委托管理员组网，再编排讨论组与执行组完成用户任务。",
  "management_parent_id": null,
  "divergence": 0,
  "aggregation": "sum",
  "module_strength": 0,
  "data_kind": null,
  "parameters": {
    "file_path": "data/root.md"
  },
  "connections": {
    "interfaces": [
      {
        "target_node_id": "administrator",
        "metadata": {
          "threshold": 1,
          "multiplier": 1,
          "channels": [
            "admin"
          ],
          "attributes": {}
        }
      }
    ]
  },
  "agent": null,
  "modules": {
    "context.network": {
      "config": {
        "sources": [
          {
            "id": "root-guide",
            "kind": "system_prompt",
            "type": "text",
            "text": "你是根 Agent，负责委托管理员放置讨论小组和执行小组预设，再调用小组入口完成任务。根只连接管理员和两个组入口，不连接成员。讨论使用 datanet_discuss，协作使用 datanet_cooperate；启动协作后用 wait_group 等待结果，避免轮询。讨论成果作为协作任务的一部分。组内成员自行认领、实现、发布、验收。"
          }
        ]
      },
      "state": {},
      "access": {
        "strength": 6,
        "channels": [
          "context.assembler"
        ]
      }
    },
    "groups.control": {
      "config": {},
      "state": {},
      "access": {
        "strength": 6,
        "channels": [
          "discussion",
          "collaboration"
        ]
      }
    }
  },
  "offered_tools": [
    {
      "ref": "harness:pwsh",
      "channels": [
        "workspace"
      ]
    },
    {
      "ref": "harness:read",
      "channels": [
        "workspace"
      ]
    },
    {
      "ref": "harness:write",
      "channels": [
        "workspace"
      ]
    },
    {
      "ref": "harness:edit",
      "channels": [
        "workspace"
      ]
    },
    {
      "ref": "harness:glob",
      "channels": [
        "workspace"
      ]
    },
    {
      "ref": "harness:grep",
      "channels": [
        "workspace"
      ]
    }
  ],
  "toolboxes": [],
  "expose": [],
  "execution": {
    "executor": "harness",
    "strength": 16,
    "channels": [
      "self",
      "admin",
      "workspace",
      "discussion",
      "collaboration",
      "context.assembler"
    ],
    "tool_sources": [
      "root",
      "administrator"
    ],
    "prepare": [
      {
        "module": "context.network",
        "operation": "assemble",
        "arguments": {},
        "channels": [
          "context.assembler"
        ]
      }
    ],
    "max_steps": 100000,
    "timeout_seconds": 86400
  },
  "context_cursor": null,
  "inputs": null
}
