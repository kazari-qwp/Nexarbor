{
  "format": "nexarbor-module/v3",
  "id": "discussion.member",
  "version": "2.0.0",
  "name": "discussion.member",
  "description": "按历史固定小组协议迁移；对象访问与局部模块执行。",
  "entry": "module.py:execute",
  "node_types": [
    "node",
    "agent"
  ],
  "requires": [],
  "config_schema": {
    "type": "object",
    "properties": {
      "role": {
        "type": "string",
        "enum": [
          "leader",
          "recorder",
          "member"
        ],
        "default": "member"
      },
      "group_module": {
        "type": "string"
      },
      "channel": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "state_schema": {
    "type": "object",
    "additionalProperties": true
  },
  "operations": [
    {
      "name": "read_round",
      "channels": [
        "discussion",
        "self"
      ],
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "result": {}
    },
    {
      "name": "submit_round",
      "channels": [
        "discussion",
        "self"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "additionalProperties": false
      },
      "result": {}
    },
    {
      "name": "skip_round",
      "channels": [
        "discussion",
        "self"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "additionalProperties": false
      },
      "result": {}
    },
    {
      "name": "write_notebook",
      "channels": [
        "discussion",
        "self"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "content"
        ],
        "additionalProperties": false
      },
      "result": {}
    },
    {
      "name": "write_output",
      "channels": [
        "discussion",
        "self"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "content"
        ],
        "additionalProperties": false
      },
      "result": {}
    },
    {
      "name": "read_output",
      "channels": [
        "discussion",
        "self"
      ],
      "parameters": {
        "type": "object",
        "additionalProperties": false
      },
      "result": {}
    },
    {
      "name": "run",
      "channels": [
        "discussion",
        "self"
      ],
      "parameters": {
        "type": "object",
        "additionalProperties": true
      },
      "result": {}
    },
    {
      "name": "notify",
      "channels": [
        "discussion",
        "self"
      ],
      "parameters": {
        "type": "object",
        "additionalProperties": true
      },
      "result": {}
    },
    {
      "name": "prepare",
      "channels": [
        "discussion",
        "self"
      ],
      "parameters": {
        "type": "object",
        "additionalProperties": true
      },
      "result": {}
    }
  ],
  "agent_tools": [
    {
      "id": "read_round",
      "name": "read_round",
      "description": "读取本组上轮讨论快照；不读取本轮其他人的实时提交。",
      "operation": "read_round"
    },
    {
      "id": "submit_round",
      "name": "submit_round",
      "description": "向公共黑板追加本轮发言并结束本轮。",
      "operation": "submit_round"
    },
    {
      "id": "skip_round",
      "name": "skip_round",
      "description": "明确跳过本轮并结束。",
      "operation": "skip_round"
    },
    {
      "id": "write_notebook",
      "name": "write_notebook",
      "description": "更新公共笔记，最多200字符。",
      "operation": "write_notebook"
    },
    {
      "id": "write_output",
      "name": "write_output",
      "description": "Recorder 修订输出板或保存最终成果。",
      "operation": "write_output"
    },
    {
      "id": "read_output",
      "name": "read_output",
      "description": "按需读取 Recorder 的输出板草稿。",
      "operation": "read_output"
    }
  ],
  "signals": [
    "discussion.round"
  ]
}
