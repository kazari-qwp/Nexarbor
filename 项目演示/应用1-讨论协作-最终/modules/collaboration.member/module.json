{
  "format": "nexarbor-module/v3",
  "id": "collaboration.member",
  "version": "2.0.0",
  "name": "collaboration.member",
  "description": "按历史固定小组协议迁移；对象访问与局部模块执行。",
  "entry": "module.py:execute",
  "node_types": [
    "node",
    "agent"
  ],
  "requires": [],
  "config_schema": {
    "type": "object",
    "properties": {
      "role": {
        "type": "string",
        "enum": [
          "leader",
          "recorder",
          "member"
        ],
        "default": "member"
      },
      "group_module": {
        "type": "string"
      },
      "channel": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "state_schema": {
    "type": "object",
    "additionalProperties": true
  },
  "operations": [
    {
      "name": "datanet_team_status",
      "channels": [
        "collaboration",
        "self"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "section": {
            "type": "string",
            "enum": [
              "all",
              "summary",
              "claims",
              "records",
              "candidate"
            ],
            "default": "all",
            "description": "选择要读取的内容。"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "result": {}
    },
    {
      "name": "datanet_team_claim",
      "channels": [
        "collaboration",
        "self"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "claim",
              "extend",
              "complete",
              "release"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "description": "预计添加、修改或删除的工作区相对文件或目录路径；调查任务可省略。extend 时补充原认领的路径。",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      "result": {}
    },
    {
      "name": "datanet_team_note",
      "channels": [
        "collaboration",
        "self"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "OBSERVED",
              "FACT",
              "FAIL",
              "PATCH_SUMMARY"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "content"
        ],
        "additionalProperties": false
      },
      "result": {}
    },
    {
      "name": "datanet_team_send",
      "channels": [
        "collaboration",
        "self"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "message_type": {
            "type": "string",
            "enum": [
              "work_order",
              "reply"
            ],
            "default": "work_order",
            "description": "work_order 需要答复；reply 可不回复。"
          }
        },
        "required": [
          "target",
          "content"
        ],
        "additionalProperties": false
      },
      "result": {}
    },
    {
      "name": "datanet_team_workspace",
      "channels": [
        "collaboration",
        "self"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "inspect",
              "sync",
              "publish"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      "result": {}
    },
    {
      "name": "datanet_team_finish",
      "channels": [
        "collaboration",
        "self"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "propose",
              "approve",
              "reject"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "test_scripts": {
            "type": "array",
            "description": "已提交的测试脚本在共同工作区中的相对路径。",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "test_results": {
            "type": "array",
            "description": "自己的测试结果文件路径。",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "log_ids": {
            "type": "array",
            "description": "附上的终端日志ID；省略时附上自己本次运行的日志。",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "action",
          "evidence"
        ],
        "additionalProperties": false
      },
      "result": {}
    },
    {
      "name": "run",
      "channels": [
        "collaboration",
        "self"
      ],
      "parameters": {
        "type": "object",
        "additionalProperties": true
      },
      "result": {}
    },
    {
      "name": "notify",
      "channels": [
        "collaboration",
        "self"
      ],
      "parameters": {
        "type": "object",
        "additionalProperties": true
      },
      "result": {}
    },
    {
      "name": "prepare",
      "channels": [
        "collaboration",
        "self"
      ],
      "parameters": {
        "type": "object",
        "additionalProperties": true
      },
      "result": {}
    },
    {
      "name": "datanet_command_logs",
      "channels": [
        "collaboration",
        "self"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list",
              "read"
            ]
          },
          "log_id": {
            "type": "string"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      "result": {}
    }
  ],
  "agent_tools": [
    {
      "id": "datanet_team_status",
      "name": "datanet_team_status",
      "description": "按需查看本组认领、共享记录或验收材料。",
      "operation": "datanet_team_status"
    },
    {
      "id": "datanet_team_claim",
      "name": "datanet_team_claim",
      "description": "认领子任务及文件路径、补充路径，或完成、释放自己的认领。",
      "operation": "datanet_team_claim"
    },
    {
      "id": "datanet_team_note",
      "name": "datanet_team_note",
      "description": "向本组共享记录发布发现、事实、失败尝试或成果摘要。",
      "operation": "datanet_team_note"
    },
    {
      "id": "datanet_team_send",
      "name": "datanet_team_send",
      "description": "向本组其他成员发信；运行中插话，空闲时唤醒。",
      "operation": "datanet_team_send"
    },
    {
      "id": "datanet_team_workspace",
      "name": "datanet_team_workspace",
      "description": "查看个人工作目录、同步共同成果或提交并整合修改。",
      "operation": "datanet_team_workspace"
    },
    {
      "id": "datanet_team_finish",
      "name": "datanet_team_finish",
      "description": "提交成果与验收材料，或批准、否决当前候选。",
      "operation": "datanet_team_finish"
    },
    {
      "id": "datanet_command_logs",
      "name": "datanet_command_logs",
      "description": "查询已执行命令的日志。",
      "operation": "datanet_command_logs"
    }
  ],
  "signals": [
    "collaboration.work"
  ]
}
